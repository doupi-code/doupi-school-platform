<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.cms.mapper.CmsBannerMapper">
    
    <resultMap type="CmsBanner" id="CmsBannerResult">
        <id     property="bannerId"   column="banner_id"   />
        <result property="title"      column="title"       />
        <result property="imageUrl"   column="image_url"   />
        <result property="linkUrl"    column="link_url"    />
        <result property="platform"   column="platform"    />
        <result property="status"     column="status"      />
        <result property="sortOrder"  column="sort_order"  />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectBannerVo">
        select banner_id, title, image_url, link_url, platform, status, sort_order, create_time, update_time
        from doupi_cms_banner
    </sql>

    <select id="selectBannerList" parameterType="CmsBanner" resultMap="CmsBannerResult">
        <include refid="selectBannerVo"/>
        <where>
            <if test="title != null and title != ''">
                and title like concat('%', #{title}, '%')
            </if>
            <if test="platform != null and platform != ''">
                and (platform = #{platform} or platform = 'all')
            </if>
            <if test="status != null and status != ''">
                and status = #{status}
            </if>
        </where>
        order by sort_order asc, banner_id desc
    </select>

    <select id="selectBannerById" parameterType="Long" resultMap="CmsBannerResult">
        <include refid="selectBannerVo"/>
        where banner_id = #{bannerId}
    </select>

    <insert id="insertBanner" parameterType="CmsBanner" useGeneratedKeys="true" keyProperty="bannerId">
        insert into doupi_cms_banner (
            title, image_url, link_url, platform, status, sort_order, create_time
        ) values (
            #{title}, #{imageUrl}, #{linkUrl}, 
            coalesce(#{platform}, 'all'), 
            coalesce(#{status}, '0'), 
            coalesce(#{sortOrder}, 0), 
            sysdate()
        )
    </insert>

    <update id="updateBanner" parameterType="CmsBanner">
        update doupi_cms_banner
        <set>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="platform != null">platform = #{platform},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_time = sysdate()
        </set>
        where banner_id = #{bannerId}
    </update>

    <delete id="deleteBannerById" parameterType="Long">
        delete from doupi_cms_banner where banner_id = #{bannerId}
    </delete>

    <delete id="deleteBannerByIds" parameterType="String">
        delete from doupi_cms_banner where banner_id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>

</mapper>
