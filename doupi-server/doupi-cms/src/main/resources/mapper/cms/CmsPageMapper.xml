<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.cms.mapper.CmsPageMapper">
    
    <resultMap type="com.doupi.cms.domain.CmsPage" id="CmsPageResult">
        <id     property="pageId"         column="page_id"         />
        <result property="pageSlug"       column="page_slug"       />
        <result property="pageName"       column="page_name"       />
        <result property="seoTitle"       column="seo_title"       />
        <result property="seoKeywords"    column="seo_keywords"    />
        <result property="seoDescription" column="seo_description" />
        <result property="status"         column="status"          />
        <result property="createTime"     column="create_time"     />
        <result property="updateTime"     column="update_time"     />
    </resultMap>

    <sql id="selectPageVo">
        select page_id, page_slug, page_name, seo_title, seo_keywords, seo_description, status, create_time, update_time
        from doupi_cms_page
    </sql>

    <select id="selectPageById" parameterType="Long" resultMap="CmsPageResult">
        <include refid="selectPageVo"/>
        where page_id = #{pageId}
    </select>

    <select id="selectPageBySlug" parameterType="String" resultMap="CmsPageResult">
        <include refid="selectPageVo"/>
        where page_slug = #{pageSlug}
        limit 1
    </select>

    <select id="selectPageList" parameterType="com.doupi.cms.domain.CmsPage" resultMap="CmsPageResult">
        <include refid="selectPageVo"/>
        <where>
            <if test="pageName != null and pageName != ''">
                AND page_name like concat('%', #{pageName}, '%')
            </if>
            <if test="pageSlug != null and pageSlug != ''">
                AND page_slug = #{pageSlug}
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by page_id asc
    </select>

    <insert id="insertPage" parameterType="com.doupi.cms.domain.CmsPage" useGeneratedKeys="true" keyProperty="pageId">
        insert into doupi_cms_page (page_slug, page_name, seo_title, seo_keywords, seo_description, status, create_time)
        values (#{pageSlug}, #{pageName}, #{seoTitle}, #{seoKeywords}, #{seoDescription}, #{status}, sysdate())
    </insert>

    <update id="updatePage" parameterType="com.doupi.cms.domain.CmsPage">
        update doupi_cms_page
        <set>
            <if test="pageSlug != null and pageSlug != ''">page_slug = #{pageSlug},</if>
            <if test="pageName != null and pageName != ''">page_name = #{pageName},</if>
            <if test="seoTitle != null">seo_title = #{seoTitle},</if>
            <if test="seoKeywords != null">seo_keywords = #{seoKeywords},</if>
            <if test="seoDescription != null">seo_description = #{seoDescription},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            update_time = sysdate()
        </set>
        where page_id = #{pageId}
    </update>

    <delete id="deletePageById" parameterType="Long">
        delete from doupi_cms_page where page_id = #{pageId}
    </delete>

</mapper>
