<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.stock.mapper.StockInItemMapper">
    
    <resultMap type="StockInItem" id="StockInItemResult">
        <result property="itemId"    column="item_id"    />
        <result property="inId"    column="in_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="quantity"    column="quantity"    />
        <result property="price"    column="price"    />
        <result property="amount"    column="amount"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="stockNum"    column="stock_num"    />
    </resultMap>

    <sql id="selectStockInItemVo">
        select i.item_id, i.in_id, i.goods_id, i.quantity, i.price, i.amount, i.create_by, i.create_time, i.update_by, i.update_time,
               g.goods_name, g.spec, g.unit, g.stock_num
        from edu_stock_in_item i
        left join edu_goods g on i.goods_id = g.goods_id
    </sql>

    <select id="selectEduStockInItemList" parameterType="StockInItem" resultMap="StockInItemResult">
        <include refid="selectStockInItemVo"/>
        <where>  
            <if test="inId != null "> and in_id = #{inId}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
            <if test="price != null "> and price = #{price}</if>
            <if test="amount != null "> and amount = #{amount}</if>
        </where>
    </select>
    
    <select id="selectEduStockInItemByItemId" parameterType="Long" resultMap="StockInItemResult">
        <include refid="selectStockInItemVo"/>
        where item_id = #{itemId}
    </select>

    <insert id="insertEduStockInItem" parameterType="StockInItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into edu_stock_in_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inId != null">in_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="quantity != null">quantity,</if>
            <if test="price != null">price,</if>
            <if test="amount != null">amount,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inId != null">#{inId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="price != null">#{price},</if>
            <if test="amount != null">#{amount},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEduStockInItem" parameterType="StockInItem">
        update edu_stock_in_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="inId != null">in_id = #{inId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="price != null">price = #{price},</if>
            <if test="amount != null">amount = #{amount},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <delete id="deleteEduStockInItemByItemId" parameterType="Long">
        delete from edu_stock_in_item where item_id = #{itemId}
    </delete>

    <delete id="deleteEduStockInItemByItemIds" parameterType="String">
        delete from edu_stock_in_item where item_id in 
        <foreach item="itemId" collection="array" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>

    <delete id="deleteEduStockInItemByInId" parameterType="Long">
        delete from edu_stock_in_item where in_id = #{inId}
    </delete>

    <select id="selectItemsByInId" parameterType="Long" resultMap="StockInItemResult">
        <include refid="selectStockInItemVo"/>
        where i.in_id = #{inId}
    </select>

    <insert id="batchInsertStockInItems">
        insert into edu_stock_in_item (in_id, goods_id, quantity, price, amount, create_by, create_time)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.inId}, #{item.goodsId}, #{item.quantity}, #{item.price}, #{item.amount}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>
</mapper>