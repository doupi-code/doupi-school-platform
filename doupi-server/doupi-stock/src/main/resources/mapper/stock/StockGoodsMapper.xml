<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.stock.mapper.StockGoodsMapper">
    
    <resultMap type="StockGoods" id="StockGoodsResult">
        <result property="goodsId"    column="goods_id"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="category"    column="category"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="supplierName"    column="supplier_name"    />
        <result property="grade"    column="grade"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="stockNum"    column="stock_num"    />
        <result property="conversionRate" column="conversion_rate" />
        <result property="baseUnit" column="base_unit" />
        <result property="remainSheets" column="remain_sheets" />
        <result property="warnLow"    column="warn_low"    />
        <result property="location"    column="location"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectStockGoodsVo">
        select g.goods_id, g.goods_name, g.category, g.supplier_id, s.supplier_name, g.grade, g.spec, g.unit, g.stock_num, g.conversion_rate, g.base_unit, g.remain_sheets, g.warn_low, g.location, g.create_by, g.create_time, g.update_by, g.update_time, g.del_flag
        from edu_goods g
        left join edu_supplier s on g.supplier_id = s.supplier_id
    </sql>

    <select id="selectEduGoodsList" parameterType="StockGoods" resultMap="StockGoodsResult">
        <include refid="selectStockGoodsVo"/>
        <where>  
            and g.del_flag = '0'
            <if test="goodsName != null  and goodsName != ''"> and g.goods_name like concat('%', #{goodsName}, '%')</if>
            <if test="category != null  and category != ''"> and g.category = #{category}</if>
            <if test="supplierId != null "> and g.supplier_id = #{supplierId}</if>
            <if test="grade != null  and grade != ''"> and g.grade = #{grade}</if>
            <if test="spec != null  and spec != ''"> and g.spec = #{spec}</if>
            <if test="unit != null  and unit != ''"> and g.unit = #{unit}</if>
            <if test="stockNum != null "> and g.stock_num = #{stockNum}</if>
            <if test="warnLow != null "> and g.warn_low = #{warnLow}</if>
            <if test="location != null  and location != ''"> and g.location = #{location}</if>
            <if test="params.isWarn != null and params.isWarn == 'true'"> and g.stock_num &lt; g.warn_low</if>
        </where>
    </select>
    
    <select id="selectEduGoodsByGoodsId" parameterType="Long" resultMap="StockGoodsResult">
        <include refid="selectStockGoodsVo"/>
        where g.goods_id = #{goodsId}
    </select>

    <insert id="insertEduGoods" parameterType="StockGoods" useGeneratedKeys="true" keyProperty="goodsId">
        insert into edu_goods
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name,</if>
            <if test="category != null and category != ''">category,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="grade != null">grade,</if>
            <if test="spec != null">spec,</if>
            <if test="unit != null and unit != ''">unit,</if>
            <if test="stockNum != null">stock_num,</if>
            <if test="conversionRate != null">conversion_rate,</if>
            <if test="baseUnit != null and baseUnit != ''">base_unit,</if>
            <if test="remainSheets != null">remain_sheets,</if>
            <if test="warnLow != null">warn_low,</if>
            <if test="location != null">location,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">#{goodsName},</if>
            <if test="category != null and category != ''">#{category},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="grade != null">#{grade},</if>
            <if test="spec != null">#{spec},</if>
            <if test="unit != null and unit != ''">#{unit},</if>
            <if test="stockNum != null">#{stockNum},</if>
            <if test="conversionRate != null">#{conversionRate},</if>
            <if test="baseUnit != null and baseUnit != ''">#{baseUnit},</if>
            <if test="remainSheets != null">#{remainSheets},</if>
            <if test="warnLow != null">#{warnLow},</if>
            <if test="location != null">#{location},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateEduGoods" parameterType="StockGoods">
        update edu_goods
        <trim prefix="SET" suffixOverrides=",">
            <if test="goodsName != null and goodsName != ''">goods_name = #{goodsName},</if>
            <if test="category != null and category != ''">category = #{category},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="spec != null">spec = #{spec},</if>
            <if test="unit != null and unit != ''">unit = #{unit},</if>
            <if test="stockNum != null">stock_num = #{stockNum},</if>
            <if test="conversionRate != null">conversion_rate = #{conversionRate},</if>
            <if test="baseUnit != null and baseUnit != ''">base_unit = #{baseUnit},</if>
            <if test="remainSheets != null">remain_sheets = #{remainSheets},</if>
            <if test="warnLow != null">warn_low = #{warnLow},</if>
            <if test="location != null">location = #{location},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where goods_id = #{goodsId}
    </update>

    <update id="deleteEduGoodsByGoodsId" parameterType="Long">
        update edu_goods set del_flag = '2' where goods_id = #{goodsId}
    </update>

    <update id="deleteEduGoodsByGoodsIds" parameterType="String">
        update edu_goods set del_flag = '2' where goods_id in 
        <foreach item="goodsId" collection="array" open="(" separator="," close=")">
            #{goodsId}
        </foreach>
    </update>

    <update id="addStock">
        update edu_goods set stock_num = stock_num + #{num} where goods_id = #{goodsId}
    </update>

    <update id="deductStock">
        update edu_goods set stock_num = stock_num - #{num} where goods_id = #{goodsId} and stock_num &gt;= #{num}
    </update>

    <update id="updateStockNum">
        update edu_goods set stock_num = #{stockNum} where goods_id = #{goodsId}
    </update>
</mapper>