<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.stock.mapper.StockOutItemMapper">
    
    <resultMap type="StockOutItem" id="StockOutItemResult">
        <result property="itemId"    column="item_id"    />
        <result property="outId"    column="out_id"    />
        <result property="goodsId"    column="goods_id"    />
        <result property="quantity"    column="quantity"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="goodsName"    column="goods_name"    />
        <result property="spec"    column="spec"    />
        <result property="unit"    column="unit"    />
        <result property="stockNum"    column="stock_num"    />
    </resultMap>

    <sql id="selectStockOutItemVo">
        select i.item_id, i.out_id, i.goods_id, i.quantity, i.create_by, i.create_time, i.update_by, i.update_time,
               g.goods_name, g.spec, g.unit, g.stock_num
        from edu_stock_out_item i
        left join edu_goods g on i.goods_id = g.goods_id
    </sql>

    <select id="selectEduStockOutItemList" parameterType="StockOutItem" resultMap="StockOutItemResult">
        <include refid="selectStockOutItemVo"/>
        <where>  
            <if test="outId != null "> and out_id = #{outId}</if>
            <if test="goodsId != null "> and goods_id = #{goodsId}</if>
            <if test="quantity != null "> and quantity = #{quantity}</if>
        </where>
    </select>
    
    <select id="selectEduStockOutItemByItemId" parameterType="Long" resultMap="StockOutItemResult">
        <include refid="selectStockOutItemVo"/>
        where item_id = #{itemId}
    </select>

    <insert id="insertEduStockOutItem" parameterType="StockOutItem" useGeneratedKeys="true" keyProperty="itemId">
        insert into edu_stock_out_item
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="outId != null">out_id,</if>
            <if test="goodsId != null">goods_id,</if>
            <if test="quantity != null">quantity,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="outId != null">#{outId},</if>
            <if test="goodsId != null">#{goodsId},</if>
            <if test="quantity != null">#{quantity},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEduStockOutItem" parameterType="StockOutItem">
        update edu_stock_out_item
        <trim prefix="SET" suffixOverrides=",">
            <if test="outId != null">out_id = #{outId},</if>
            <if test="goodsId != null">goods_id = #{goodsId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where item_id = #{itemId}
    </update>

    <delete id="deleteEduStockOutItemByItemId" parameterType="Long">
        delete from edu_stock_out_item where item_id = #{itemId}
    </delete>

    <delete id="deleteEduStockOutItemByItemIds" parameterType="String">
        delete from edu_stock_out_item where item_id in 
        <foreach item="itemId" collection="array" open="(" separator="," close=")">
            #{itemId}
        </foreach>
    </delete>

    <delete id="deleteEduStockOutItemByOutId" parameterType="Long">
        delete from edu_stock_out_item where out_id = #{outId}
    </delete>

    <select id="selectItemsByOutId" parameterType="Long" resultMap="StockOutItemResult">
        <include refid="selectStockOutItemVo"/>
        where i.out_id = #{outId}
    </select>

    <insert id="batchInsertStockOutItems">
        insert into edu_stock_out_item (out_id, goods_id, quantity, create_by, create_time)
        values
        <foreach item="item" collection="list" separator=",">
            (#{item.outId}, #{item.goodsId}, #{item.quantity}, #{item.createBy}, #{item.createTime})
        </foreach>
    </insert>
</mapper>