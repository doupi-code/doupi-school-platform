<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.stock.mapper.StockInMapper">
    
    <resultMap type="StockIn" id="StockInResult">
        <result property="inId"    column="in_id"    />
        <result property="inNo"    column="in_no"    />
        <result property="inType"    column="in_type"    />
        <result property="supplierId"    column="supplier_id"    />
        <result property="inTime"    column="in_time"    />
        <result property="operator"    column="operator"    />
        <result property="operatorId"    column="operator_id"    />
        <result property="operatorNickName"    column="operator_nick_name"    />
        <result property="remark"    column="remark"    />
        <result property="status"    column="status"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
        <result property="supplierName"    column="supplier_name"    />
    </resultMap>

    <sql id="selectStockInVo">
        select i.in_id, i.in_no, i.in_type, i.supplier_id, i.in_time, i.operator, i.operator_id, i.remark, i.status, i.create_by, i.create_time, i.update_by, i.update_time, i.del_flag,
               s.supplier_name, u.nick_name as operator_nick_name
        from edu_stock_in i
        left join edu_supplier s on i.supplier_id = s.supplier_id
        left join sys_user u on i.operator_id = u.user_id
    </sql>

    <select id="selectEduStockInList" parameterType="StockIn" resultMap="StockInResult">
        <include refid="selectStockInVo"/>
        <where>  
            and i.del_flag = '0'
            <if test="inNo != null  and inNo != ''"> and i.in_no like concat('%', #{inNo}, '%')</if>
            <if test="inType != null  and inType != ''"> and i.in_type = #{inType}</if>
            <if test="supplierId != null "> and i.supplier_id = #{supplierId}</if>
            <if test="params.beginTime != null and params.beginTime != ''"><!-- 开始时间检索 -->
                and date_format(i.in_time,'%y%m%d') &gt;= date_format(#{params.beginTime},'%y%m%d')
            </if>
            <if test="params.endTime != null and params.endTime != ''"><!-- 结束时间检索 -->
                and date_format(i.in_time,'%y%m%d') &lt;= date_format(#{params.endTime},'%y%m%d')
            </if>
            <if test="operator != null  and operator != ''"> and i.operator like concat('%', #{operator}, '%')</if>
            <if test="status != null  and status != ''"> and i.status = #{status}</if>
        </where>
        order by i.in_id desc
    </select>
    
    <select id="selectEduStockInByInId" parameterType="Long" resultMap="StockInResult">
        <include refid="selectStockInVo"/>
        where i.in_id = #{inId}
    </select>

    <select id="selectMaxInNo" parameterType="String" resultType="String">
        select max(in_no) from edu_stock_in where in_no like concat(#{prefix}, '%')
    </select>

    <insert id="insertEduStockIn" parameterType="StockIn" useGeneratedKeys="true" keyProperty="inId">
        insert into edu_stock_in
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="inNo != null and inNo != ''">in_no,</if>
            <if test="inType != null and inType != ''">in_type,</if>
            <if test="supplierId != null">supplier_id,</if>
            <if test="inTime != null">in_time,</if>
            <if test="operator != null and operator != ''">operator,</if>
            <if test="operatorId != null">operator_id,</if>
            <if test="remark != null">remark,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null">create_by,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateBy != null">update_by,</if>
            <if test="updateTime != null">update_time,</if>
            <if test="delFlag != null">del_flag,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="inNo != null and inNo != ''">#{inNo},</if>
            <if test="inType != null and inType != ''">#{inType},</if>
            <if test="supplierId != null">#{supplierId},</if>
            <if test="inTime != null">#{inTime},</if>
            <if test="operator != null and operator != ''">#{operator},</if>
            <if test="operatorId != null">#{operatorId},</if>
            <if test="remark != null">#{remark},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
            <if test="delFlag != null">#{delFlag},</if>
         </trim>
    </insert>

    <update id="updateEduStockIn" parameterType="StockIn">
        update edu_stock_in
        <trim prefix="SET" suffixOverrides=",">
            <if test="inNo != null and inNo != ''">in_no = #{inNo},</if>
            <if test="inType != null and inType != ''">in_type = #{inType},</if>
            <if test="supplierId != null">supplier_id = #{supplierId},</if>
            <if test="inTime != null">in_time = #{inTime},</if>
            <if test="operator != null and operator != ''">operator = #{operator},</if>
            <if test="operatorId != null">operator_id = #{operatorId},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="createBy != null">create_by = #{createBy},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
        where in_id = #{inId}
    </update>

    <update id="deleteEduStockInByInId" parameterType="Long">
        update edu_stock_in set del_flag = '2' where in_id = #{inId}
    </update>

    <update id="deleteEduStockInByInIds" parameterType="String">
        update edu_stock_in set del_flag = '2' where in_id in 
        <foreach item="inId" collection="array" open="(" separator="," close=")">
            #{inId}
        </foreach>
    </update>
</mapper>