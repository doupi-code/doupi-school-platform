# ==============================================================================
# 教务物资出入库管理系统 - 生产环境变量配置（用于连接单独部署的 MySQL 和 Redis）
# ==============================================================================

# 1. 独立部署的 MySQL 数据库配置
MYSQL_HOST=192.168.1.100
MYSQL_PORT=3306
MYSQL_DB=stuck-mg
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# 2. 独立部署的 Redis 缓存配置
REDIS_HOST=192.168.1.100
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# 3. 文件上传路径与日志目录（宿主机物理目录）
UPLOAD_PATH=/home/ruoyi/uploadPath
LOGS_PATH=/home/ruoyi/logs

# 4. 容器对外暴露端口
FRONTEND_PORT=80
BACKEND_PORT=8080
