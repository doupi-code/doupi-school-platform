<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.edu.mapper.EduTeacherMapper">
    
    <resultMap type="EduTeacher" id="EduTeacherResult">
        <result property="teacherId"    column="teacher_id"    />
        <result property="teacherName"    column="teacher_name"    />
        <result property="dept"    column="dept"    />
        <result property="grade"    column="grade"    />
        <result property="classIds"    column="class_ids"    />
        <result property="subject"    column="subject"    />
        <result property="phone"    column="phone"    />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"    column="update_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectEduTeacherVo">
        select 
            u.user_id as teacher_id,
            u.nick_name as teacher_name,
            d.dept_name as dept,
            u.grade,
            u.class_ids,
            u.subject,
            u.phonenumber as phone,
            u.create_by,
            u.create_time,
            u.update_by,
            u.update_time,
            u.del_flag
        from sys_user u
        left join sys_dept d on u.dept_id = d.dept_id
    </sql>

    <select id="selectEduTeacherList" parameterType="EduTeacher" resultMap="EduTeacherResult">
        <include refid="selectEduTeacherVo"/>
        where u.del_flag = '0'
          and exists (
              select 1 from sys_user_role ur
              inner join sys_role r on ur.role_id = r.role_id
              where ur.user_id = u.user_id
                and r.role_key in ('teacher', 'teacher_recruit', 'admin_staff')
          )
        <if test="teacherId != null"> and u.user_id = #{teacherId}</if>
        <if test="teacherName != null and teacherName != ''"> and u.nick_name like concat('%', #{teacherName}, '%')</if>
        <if test="dept != null and dept != ''"> and d.dept_name like concat('%', #{dept}, '%')</if>
        <if test="grade != null and grade != ''"> and u.grade = #{grade}</if>
        <if test="classIds != null and classIds != ''"> and u.class_ids = #{classIds}</if>
        <if test="subject != null and subject != ''"> and u.subject like concat('%', #{subject}, '%')</if>
        <if test="phone != null and phone != ''"> and u.phonenumber like concat('%', #{phone}, '%')</if>
        order by u.user_id asc
    </select>
    
    <select id="selectEduTeacherByTeacherId" parameterType="Long" resultMap="EduTeacherResult">
        <include refid="selectEduTeacherVo"/>
        where u.user_id = #{teacherId}
    </select>

    <insert id="insertEduTeacher" parameterType="EduTeacher" useGeneratedKeys="true" keyProperty="teacherId">
        insert into sys_user
        <trim prefix="(" suffix=")" suffixOverrides=",">
            user_name,
            password,
            <if test="teacherName != null and teacherName != ''">nick_name,</if>
            <if test="dept != null">remark,</if>
            <if test="grade != null">grade,</if>
            <if test="classIds != null">class_ids,</if>
            <if test="subject != null">subject,</if>
            <if test="phone != null">phonenumber,</if>
            <if test="createBy != null">create_by,</if>
            create_time,
            status,
            del_flag,
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            concat('tea_', unix_timestamp()),
            '$2a$10$7JB720yubVSZvUI0rEqK/.VqGOZTH.ulu33dHOiBE8ByOhJIrdAu2',
            <if test="teacherName != null and teacherName != ''">#{teacherName},</if>
            <if test="dept != null">#{dept},</if>
            <if test="grade != null">#{grade},</if>
            <if test="classIds != null">#{classIds},</if>
            <if test="subject != null">#{subject},</if>
            <if test="phone != null">#{phone},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate(),
            '0',
            '0',
         </trim>
    </insert>

    <update id="updateEduTeacher" parameterType="EduTeacher">
        update sys_user
        <trim prefix="SET" suffixOverrides=",">
            <if test="teacherName != null and teacherName != ''">nick_name = #{teacherName},</if>
            <if test="grade != null">grade = #{grade},</if>
            <if test="classIds != null">class_ids = #{classIds},</if>
            <if test="subject != null">subject = #{subject},</if>
            <if test="phone != null">phonenumber = #{phone},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where user_id = #{teacherId}
    </update>

    <update id="deleteEduTeacherByTeacherId" parameterType="Long">
        update sys_user set del_flag = '2', update_time = sysdate() where user_id = #{teacherId}
    </update>

    <update id="deleteEduTeacherByTeacherIds">
        update sys_user set del_flag = '2', update_time = sysdate() where user_id in 
        <foreach item="teacherId" collection="array" open="(" separator="," close=")">
            #{teacherId}
        </foreach>
    </update>
</mapper>