<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.edu.mapper.EduGoodsKitItemMapper">
    
    <resultMap type="com.doupi.edu.domain.EduGoodsKitItem" id="EduGoodsKitItemResult">
        <result property="itemId" column="item_id" />
        <result property="kitId" column="kit_id" />
        <result property="goodsId" column="goods_id" />
        <result property="quantity" column="quantity" />
        <result property="sortOrder" column="sort_order" />
        <result property="remark" column="remark" />
        <result property="goodsName" column="goods_name" />
        <result property="spec" column="spec" />
        <result property="unit" column="unit" />
        <result property="stockNum" column="stock_num" />
        <result property="category" column="category" />
    </resultMap>

    <select id="selectItemsByKitId" parameterType="Long" resultMap="EduGoodsKitItemResult">
        select ki.item_id, ki.kit_id, ki.goods_id, ki.quantity, ki.sort_order, ki.remark,
               g.goods_name, g.spec, g.unit, g.stock_num, g.category
        from edu_goods_kit_item ki
        inner join edu_goods g on ki.goods_id = g.goods_id and g.del_flag = '0'
        where ki.kit_id = #{kitId}
        order by ki.sort_order asc, ki.item_id asc
    </select>

    <insert id="batchInsertKitItems">
        insert into edu_goods_kit_item (kit_id, goods_id, quantity, sort_order, remark)
        values
        <foreach item="item" index="index" collection="items" separator=",">
            (#{item.kitId}, #{item.goodsId}, #{item.quantity}, #{item.sortOrder}, #{item.remark})
        </foreach>
    </insert>

    <delete id="deleteItemsByKitId" parameterType="Long">
        delete from edu_goods_kit_item where kit_id = #{kitId}
    </delete>

    <delete id="deleteItemsByKitIds" parameterType="String">
        delete from edu_goods_kit_item where kit_id in 
        <foreach item="kitId" collection="array" open="(" separator="," close=")">
            #{kitId}
        </foreach>
    </delete>
</mapper>
