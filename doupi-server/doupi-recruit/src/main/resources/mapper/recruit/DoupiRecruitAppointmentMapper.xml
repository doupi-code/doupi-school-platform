<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.recruit.mapper.DoupiRecruitAppointmentMapper">
    
    <resultMap type="com.doupi.recruit.domain.DoupiRecruitAppointment" id="DoupiRecruitAppointmentResult">
        <result property="appointmentId"    column="appointment_id"    />
        <result property="appointmentNo"    column="appointment_no"    />
        <result property="openid"           column="openid"            />
        <result property="status"           column="status"            />
        <result property="parentName"       column="parent_name"       />
        <result property="parentPhone"      column="parent_phone"      />
        <result property="studentName"      column="student_name"      />
        <result property="studentGender"    column="student_gender"    />
        <result property="studentGrade"     column="student_grade"     />
        <result property="currentSchool"    column="current_school"    />
        <result property="campusId"         column="campus_id"         />
        <result property="campusName"       column="campus_name"       />
        <result property="visitDate"        column="visit_date"        />
        <result property="timeSlot"         column="time_slot"         />
        <result property="checkInCode"      column="check_in_code"     />
        <result property="teacherId"        column="teacher_id"        />
        <result property="teacherName"      column="teacher_name"      />
        <result property="verifyTime"       column="verify_time"       />
        <result property="verifier"         column="verifier"          />
        <result property="remark"           column="remark"            />
        <result property="auditRemark"      column="audit_remark"      />
        <result property="createBy"         column="create_by"         />
        <result property="createTime"       column="create_time"       />
        <result property="updateBy"         column="update_by"         />
        <result property="updateTime"       column="update_time"       />
    </resultMap>

    <sql id="selectDoupiRecruitAppointmentVo">
        select appointment_id, appointment_no, openid, status, parent_name, parent_phone, student_name, student_gender, student_grade, current_school, campus_id, campus_name, visit_date, time_slot, check_in_code, teacher_id, teacher_name, verify_time, verifier, remark, audit_remark, create_by, create_time, update_by, update_time 
        from doupi_recruit_appointment
    </sql>

    <select id="selectDoupiRecruitAppointmentList" parameterType="com.doupi.recruit.domain.DoupiRecruitAppointment" resultMap="DoupiRecruitAppointmentResult">
        <include refid="selectDoupiRecruitAppointmentVo"/>
        <where>  
            <if test="appointmentNo != null and appointmentNo != ''"> and appointment_no like concat('%', #{appointmentNo}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
            <if test="parentName != null and parentName != ''"> and parent_name like concat('%', #{parentName}, '%')</if>
            <if test="parentPhone != null and parentPhone != ''"> and parent_phone like concat('%', #{parentPhone}, '%')</if>
            <if test="studentName != null and studentName != ''"> and student_name like concat('%', #{studentName}, '%')</if>
            <if test="studentGrade != null and studentGrade != ''"> and student_grade = #{studentGrade}</if>
            <if test="campusId != null and campusId != ''"> and campus_id = #{campusId}</if>
            <if test="visitDate != null and visitDate != ''"> and visit_date = #{visitDate}</if>
            <if test="checkInCode != null and checkInCode != ''"> and check_in_code = #{checkInCode}</if>
            <if test="teacherId != null and teacherId != ''"> and teacher_id = #{teacherId}</if>
            <if test="openid != null and openid != ''"> and openid = #{openid}</if>
        </where>
        order by create_time desc
    </select>
    
    <select id="selectDoupiRecruitAppointmentById" parameterType="Long" resultMap="DoupiRecruitAppointmentResult">
        <include refid="selectDoupiRecruitAppointmentVo"/>
        where appointment_id = #{appointmentId}
    </select>

    <select id="selectDoupiRecruitAppointmentByNo" parameterType="String" resultMap="DoupiRecruitAppointmentResult">
        <include refid="selectDoupiRecruitAppointmentVo"/>
        where appointment_no = #{appointmentNo}
    </select>

    <select id="selectDoupiRecruitAppointmentByCheckInCode" parameterType="String" resultMap="DoupiRecruitAppointmentResult">
        <include refid="selectDoupiRecruitAppointmentVo"/>
        where check_in_code = #{checkInCode}
    </select>

    <select id="countByStatus" resultType="map">
        select status, count(1) as total from doupi_recruit_appointment group by status
    </select>

    <select id="countByGrade" resultType="map">
        select student_grade as grade, count(1) as total from doupi_recruit_appointment group by student_grade
    </select>

    <select id="countByVisitDate" resultType="map">
        select visit_date as visitDate, count(1) as total 
        from doupi_recruit_appointment 
        where 1=1
        <if test="startDate != null and startDate != ''"> and visit_date &gt;= #{startDate}</if>
        <if test="endDate != null and endDate != ''"> and visit_date &lt;= #{endDate}</if>
        group by visit_date
        order by visit_date asc
    </select>
        
    <insert id="insertDoupiRecruitAppointment" parameterType="com.doupi.recruit.domain.DoupiRecruitAppointment" useGeneratedKeys="true" keyProperty="appointmentId">
        insert into doupi_recruit_appointment
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="appointmentNo != null and appointmentNo != ''">appointment_no,</if>
            <if test="openid != null">openid,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="parentName != null and parentName != ''">parent_name,</if>
            <if test="parentPhone != null and parentPhone != ''">parent_phone,</if>
            <if test="studentName != null and studentName != ''">student_name,</if>
            <if test="studentGender != null">student_gender,</if>
            <if test="studentGrade != null and studentGrade != ''">student_grade,</if>
            <if test="currentSchool != null">current_school,</if>
            <if test="campusId != null">campus_id,</if>
            <if test="campusName != null">campus_name,</if>
            <if test="visitDate != null and visitDate != ''">visit_date,</if>
            <if test="timeSlot != null and timeSlot != ''">time_slot,</if>
            <if test="checkInCode != null">check_in_code,</if>
            <if test="teacherId != null">teacher_id,</if>
            <if test="teacherName != null">teacher_name,</if>
            <if test="verifyTime != null">verify_time,</if>
            <if test="verifier != null">verifier,</if>
            <if test="remark != null">remark,</if>
            <if test="auditRemark != null">audit_remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="appointmentNo != null and appointmentNo != ''">#{appointmentNo},</if>
            <if test="openid != null">#{openid},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="parentName != null and parentName != ''">#{parentName},</if>
            <if test="parentPhone != null and parentPhone != ''">#{parentPhone},</if>
            <if test="studentName != null and studentName != ''">#{studentName},</if>
            <if test="studentGender != null">#{studentGender},</if>
            <if test="studentGrade != null and studentGrade != ''">#{studentGrade},</if>
            <if test="currentSchool != null">#{currentSchool},</if>
            <if test="campusId != null">#{campusId},</if>
            <if test="campusName != null">#{campusName},</if>
            <if test="visitDate != null and visitDate != ''">#{visitDate},</if>
            <if test="timeSlot != null and timeSlot != ''">#{timeSlot},</if>
            <if test="checkInCode != null">#{checkInCode},</if>
            <if test="teacherId != null">#{teacherId},</if>
            <if test="teacherName != null">#{teacherName},</if>
            <if test="verifyTime != null">#{verifyTime},</if>
            <if test="verifier != null">#{verifier},</if>
            <if test="remark != null">#{remark},</if>
            <if test="auditRemark != null">#{auditRemark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateDoupiRecruitAppointment" parameterType="com.doupi.recruit.domain.DoupiRecruitAppointment">
        update doupi_recruit_appointment
        <trim prefix="SET" suffixOverrides=",">
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="parentName != null and parentName != ''">parent_name = #{parentName},</if>
            <if test="parentPhone != null and parentPhone != ''">parent_phone = #{parentPhone},</if>
            <if test="studentName != null and studentName != ''">student_name = #{studentName},</if>
            <if test="studentGender != null">student_gender = #{studentGender},</if>
            <if test="studentGrade != null and studentGrade != ''">student_grade = #{studentGrade},</if>
            <if test="currentSchool != null">current_school = #{currentSchool},</if>
            <if test="campusId != null">campus_id = #{campusId},</if>
            <if test="campusName != null">campus_name = #{campusName},</if>
            <if test="visitDate != null and visitDate != ''">visit_date = #{visitDate},</if>
            <if test="timeSlot != null and timeSlot != ''">time_slot = #{timeSlot},</if>
            <if test="checkInCode != null">check_in_code = #{checkInCode},</if>
            <if test="teacherId != null">teacher_id = #{teacherId},</if>
            <if test="teacherName != null">teacher_name = #{teacherName},</if>
            <if test="verifyTime != null">verify_time = #{verifyTime},</if>
            <if test="verifier != null">verifier = #{verifier},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="auditRemark != null">audit_remark = #{auditRemark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where appointment_id = #{appointmentId}
    </update>

    <delete id="deleteDoupiRecruitAppointmentById" parameterType="Long">
        delete from doupi_recruit_appointment where appointment_id = #{appointmentId}
    </delete>

    <delete id="deleteDoupiRecruitAppointmentByIds" parameterType="String">
        delete from doupi_recruit_appointment where appointment_id in 
        <foreach item="appointmentId" collection="array" open="(" separator="," close=")">
            #{appointmentId}
        </foreach>
    </delete>
</mapper>
