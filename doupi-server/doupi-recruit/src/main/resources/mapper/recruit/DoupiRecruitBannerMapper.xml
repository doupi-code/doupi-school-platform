<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.doupi.recruit.mapper.DoupiRecruitBannerMapper">
    
    <resultMap type="com.doupi.recruit.domain.DoupiRecruitBanner" id="DoupiRecruitBannerResult">
        <result property="bannerId"   column="banner_id"   />
        <result property="title"      column="title"       />
        <result property="imageUrl"   column="image_url"   />
        <result property="linkUrl"    column="link_url"    />
        <result property="status"     column="status"      />
        <result property="sortOrder"  column="sort_order"  />
        <result property="createTime" column="create_time" />
        <result property="updateTime" column="update_time" />
    </resultMap>

    <sql id="selectDoupiRecruitBannerVo">
        select banner_id, title, image_url, link_url, status, sort_order, create_time, update_time from doupi_recruit_banner
    </sql>

    <select id="selectDoupiRecruitBannerList" parameterType="com.doupi.recruit.domain.DoupiRecruitBanner" resultMap="DoupiRecruitBannerResult">
        <include refid="selectDoupiRecruitBannerVo"/>
        <where>  
            <if test="title != null and title != ''"> and title like concat('%', #{title}, '%')</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by sort_order asc
    </select>
    
    <select id="selectDoupiRecruitBannerById" parameterType="Long" resultMap="DoupiRecruitBannerResult">
        <include refid="selectDoupiRecruitBannerVo"/>
        where banner_id = #{bannerId}
    </select>
        
    <insert id="insertDoupiRecruitBanner" parameterType="com.doupi.recruit.domain.DoupiRecruitBanner" useGeneratedKeys="true" keyProperty="bannerId">
        insert into doupi_recruit_banner
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">title,</if>
            <if test="imageUrl != null and imageUrl != ''">image_url,</if>
            <if test="linkUrl != null">link_url,</if>
            <if test="status != null">status,</if>
            <if test="sortOrder != null">sort_order,</if>
            create_time
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="title != null and title != ''">#{title},</if>
            <if test="imageUrl != null and imageUrl != ''">#{imageUrl},</if>
            <if test="linkUrl != null">#{linkUrl},</if>
            <if test="status != null">#{status},</if>
            <if test="sortOrder != null">#{sortOrder},</if>
            sysdate()
         </trim>
    </insert>

    <update id="updateDoupiRecruitBanner" parameterType="com.doupi.recruit.domain.DoupiRecruitBanner">
        update doupi_recruit_banner
        <trim prefix="SET" suffixOverrides=",">
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="imageUrl != null and imageUrl != ''">image_url = #{imageUrl},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="status != null">status = #{status},</if>
            <if test="sortOrder != null">sort_order = #{sortOrder},</if>
            update_time = sysdate()
        </trim>
        where banner_id = #{bannerId}
    </update>

    <delete id="deleteDoupiRecruitBannerById" parameterType="Long">
        delete from doupi_recruit_banner where banner_id = #{bannerId}
    </delete>
</mapper>
