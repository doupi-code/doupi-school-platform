# ==========================================
# 豆皮教育系统生产环境配置变量 (.env)
# ==========================================

# 1. 数据库配置
MYSQL_HOST=doupi-mysql
MYSQL_PORT=3306
MYSQL_DB=doupi
MYSQL_USER=root
MYSQL_PASSWORD=doupi_secure_pwd_2026

# 2. Redis 缓存配置
REDIS_HOST=doupi-redis
REDIS_PORT=6379
REDIS_PASSWORD=doupi_redis_pwd_2026

# 3. 后端服务与端口
BACKEND_PORT=8080
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443

# 4. 存储路径
UPLOAD_PATH=/home/doupi/uploadPath
LOGS_PATH=/home/doupi/logs
