# 豆皮教育 Spring Boot 4 后端容器镜像
# 基于 Eclipse Temurin 17 JRE，预装字体库与图形渲染支持（保障验证码与 OCR）

FROM eclipse-temurin:17-jre-jammy

LABEL maintainer="doupi"

# 设置工作目录与时区
WORKDIR /app
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# 安装基础图形与字体依赖（防止验证码图形计算 NPE）
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    fontconfig \
    libfreetype6 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 创建运行目录及非 root 用户
RUN mkdir -p /home/doupi/uploadPath /home/doupi/logs /app/config

# 将打包好的后端产物拷贝到镜像
COPY ./doupi-admin/target/doupi-admin.jar /app/doupi-admin.jar

# 声明暴露端口
EXPOSE 8080

# 默认 JVM 参数针对 4G 内存服务器配置
ENV JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8 -Duser.timezone=GMT+08"

# 启动命令
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/doupi-admin.jar"]
