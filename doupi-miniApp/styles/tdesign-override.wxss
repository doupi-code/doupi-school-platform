/**
 * TDesign 主题覆盖 - 将默认品牌色覆盖为 #3088F4
 * 在 app.wxss 中 @import 引入，需在 tdesign 样式之后加载
 */

/* 覆盖 TDesign Button 主色按钮 */
.t-button--variant-base-theme {
  --button-bg-color: #3088F4 !important;
  --button-border-color: #3088F4 !important;
  --button-active-bg-color: #1A6DD9 !important;
  --button-active-border-color: #1A6DD9 !important;
}

/* 覆盖 TDesign 组件通用主题色变量 */
page {
  --td-brand-color: #3088F4;
  --td-brand-color-light: #5BA9FF;
  --td-brand-color-focus: #2670D4;
  --td-brand-color-hover: #2670D4;
  --td-brand-color-active: #1A6DD9;
  --td-brand-color-disabled: #A0C9FF;
  --td-brand-color-light-active: rgba(48, 136, 244, 0.08);
  --td-brand-color-light-hover: rgba(48, 136, 244, 0.12);
  --td-brand-color-focus-border: #3088F4;
  --td-brand-color-disabled-border: #E3EFFF;
  --td-success-color: #52C41A;
  --td-warning-color: #FAAD14;
  --td-error-color: #FF4D4F;
}
