.profile-edit-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 99999;
  display: flex;
  align-items: flex-end;
}

.profile-edit-sheet {
  width: 100%;
  background: #ffffff;
  border-radius: 28rpx;
  margin: 0 16rpx env(safe-area-inset-bottom);
  padding: 28rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
}

.profile-edit-sheet--avoid-tabbar {
  margin-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.profile-edit-head {
  margin-bottom: 22rpx;
}

.profile-edit-brand {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.profile-edit-brand-logo {
  width: 44rpx;
  height: 44rpx;
  border-radius: 8rpx;
}

.profile-edit-brand-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2d3d;
}

.profile-edit-subtitle {
  display: block;
  margin-top: 14rpx;
  font-size: 28rpx;
  color: #333333;
}

.native-form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.native-form-label {
  font-size: 30rpx;
  color: #333333;
}

.native-avatar-btn {
  margin: 0;
  padding: 0;
  background: transparent;
  border: none;
  display: flex;
  align-items: center;
  gap: 12rpx;
  line-height: 1;
}

.native-avatar-btn::after {
  border: none;
}

.native-avatar-img {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f1f5fb;
}

.native-arrow {
  font-size: 28rpx;
  color: #b6c0ce;
}

.native-nickname-input {
  width: 320rpx;
  height: 56rpx;
  font-size: 30rpx;
  color: #1f2d3d;
  text-align: right;
}

.profile-edit-actions {
  margin-top: 20rpx;
  display: flex;
  gap: 20rpx;
}

.profile-edit-action {
  flex: 1;
  height: 82rpx;
  border-radius: 41rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}

.profile-edit-action-cancel {
  color: #6a7180;
  background: #eceaf9;
}

.profile-edit-action-default {
  color: #3088F4;
  background: #EBF4FF;
}

.profile-edit-action-default:active {
  opacity: 0.85;
}

.profile-edit-action-save {
  color: #ffffff;
  background: linear-gradient(135deg, #4148f5 0%, #2d33dd 100%);
}

.profile-edit-action-save.disabled {
  opacity: 0.7;
}
