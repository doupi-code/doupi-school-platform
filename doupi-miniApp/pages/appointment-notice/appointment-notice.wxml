<view class="page">
  <view class="update-info" wx:if="{{updateTime}}">
    <text class="update-time">最后更新：{{updateTime}}</text>
  </view>

  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <view class="content-card">
      <rich-text nodes="{{formattedContent}}" class="rich-text"></rich-text>
    </view>
    <view class="bottom-actions">
      <button class="btn-agree" bindtap="handleAgree">{{displayText.btnReadAndAgree}}</button>
    </view>
    <view class="bottom-spacer"></view>
  </scroll-view>
</view>
