<view class="page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <t-icon name="search" size="32rpx" color="#999999"></t-icon>
      <input
        class="search-input"
        placeholder="搜索姓名、手机号"
        value="{{searchKeyword}}"
        bindinput="handleSearch"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{searchKeyword}}" bindtap="handleSearch" data-clear="true">&times;</text>
    </view>
    <view class="filter-btn" bindtap="toggleFilter">
      <t-icon name="filter" size="32rpx" color="#666666"></t-icon>
      <text>{{statusOptions[selectedStatus === 'all' ? 0 : selectedStatus === 'active' ? 1 : 2].label}}</text>
    </view>

    <!-- 筛选下拉 -->
    <view class="filter-dropdown" wx:if="{{showFilter}}">
      <view class="dropdown-mask" bindtap="toggleFilter"></view>
      <view class="dropdown-menu">
        <view
          class="dropdown-item {{selectedStatus === item.value ? 'active' : ''}}"
          wx:for="{{statusOptions}}"
          wx:key="value"
          data-value="{{item.value}}"
          bindtap="selectStatus"
        >{{item.label}}</view>
      </view>
    </view>
  </view>

  <!-- 内容区域 -->
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <text class="result-count">共 {{filteredList.length}}{{displayText.resultTeacherCountSuffix}}</text>

    <!-- 老师卡片列表 -->
    <view class="teacher-card" wx:for="{{filteredList}}" wx:key="id">
      <view class="card-top">
        <view class="teacher-avatar">
          <image
            class="avatar-img"
            src="{{item.avatar || '/images/icons/default-avatar.png'}}"
            mode="aspectFill"
          />
        </view>
        <view class="teacher-info">
          <view class="info-header">
            <text class="teacher-name">{{item.name}}</text>
            <view class="status-tag {{item.status === 'active' ? 'success' : 'disabled'}}">{{item.statusText}}</view>
          </view>
          <text class="teacher-phone">{{item.phone}}</text>
          <text class="bind-director">绑定主任：{{item.directorName}}（{{item.directorPhone}}）</text>
          <text class="bind-time">绑定时间：{{item.bindTime}}</text>
        </view>
      </view>

      <view class="card-stats">
        <view class="stat-item">
          <text class="stat-num">{{item.appointmentCount}}</text>
          <text class="stat-label">预约数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{item.verifyCount}}</text>
          <text class="stat-label">核销数</text>
        </view>
        <view class="stat-divider"></view>
        <view class="stat-item">
          <text class="stat-num">{{item.verifyRate}}%</text>
          <text class="stat-label">核销率</text>
        </view>
      </view>

      <view class="card-actions">
        <button class="btn-view" data-id="{{item.id}}" bindtap="goToTeacherDetail">{{displayText.btnViewDetail}}</button>
        <button
          class="btn-unbind {{item.status !== 'active' ? 'disabled' : ''}}"
          data-item="{{item}}"
          bindtap="handleUnbind"
          disabled="{{item.status !== 'active'}}"
        >{{item.status === 'active' ? displayText.btnUnbind : displayText.btnUnbound}}</button>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty" wx:if="{{filteredList.length === 0}}">
      <text class="empty-text">{{displayText.emptyTeachers}}</text>
      <text class="empty-desc">{{displayText.emptyTryAdjustSearchFilter}}</text>
    </view>
  </scroll-view>
</view>
