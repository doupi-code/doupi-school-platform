<view class="page">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索老师姓名或手机号"
      value="{{keyword}}"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
      confirm-type="search"
    />
    <button class="search-btn" bindtap="onSearchConfirm">搜索</button>
  </view>

  <view class="batch-bar">
    <input
      class="batch-reason-input"
      placeholder="批量驳回原因（可选）"
      value="{{batchRejectReason}}"
      bindinput="onBatchRejectReasonInput"
    />
    <view class="batch-actions">
      <button class="batch-btn" bindtap="onApproveBatch">批量通过</button>
      <button class="batch-btn batch-reject" bindtap="onRejectBatch">批量驳回</button>
    </view>
  </view>

  <scroll-view scroll-y class="list-wrap">
    <view class="audit-item" wx:for="{{list}}" wx:key="_id">
      <view class="row top">
        <view class="left">
          <view class="check {{checkedMap[item._id] ? 'checked' : ''}}" data-id="{{item._id}}" bindtap="onToggleCheck"></view>
          <text class="name">{{item.teacherName || '未命名老师'}}</text>
        </view>
        <text class="time">{{item.createdAt}}</text>
      </view>
      <view class="row"><text class="label">手机号</text><text class="value">{{item.teacherPhoneMask || '-'}}</text></view>
      <view class="row"><text class="label">申请主任</text><text class="value">{{item.directorName || '-'}}</text></view>
      <view class="reason-wrap">
        <text class="label">驳回原因</text>
        <input
          class="reason-input"
          placeholder="可选，默认：审核驳回"
          value="{{rejectReasonMap[item._id] || ''}}"
          data-id="{{item._id}}"
          bindinput="onRejectReasonInput"
        />
      </view>
      <view class="actions">
        <button class="btn pass" data-id="{{item._id}}" bindtap="onApproveOne">通过</button>
        <button class="btn reject" data-id="{{item._id}}" bindtap="onRejectOne">驳回</button>
      </view>
    </view>
    <view class="empty" wx:if="{{!loading && list.length === 0}}">暂无待审核绑定申请</view>
  </scroll-view>
</view>
