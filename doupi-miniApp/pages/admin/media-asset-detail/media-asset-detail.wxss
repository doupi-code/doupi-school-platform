.page {
  min-height: 100vh;
  padding: 24rpx;
  background: #f5f6f8;
  box-sizing: border-box;
}

.content,
.detail-list {
  display: flex;
  flex-direction: column;
}

.content {
  gap: 20rpx;
}

.preview-card,
.detail-card,
.state-card {
  background: #ffffff;
  border-radius: 24rpx;
}

.preview-card,
.detail-card {
  padding: 24rpx;
}

.state-card {
  margin-top: 120rpx;
  padding: 56rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  text-align: center;
}

.state-text {
  font-size: 28rpx;
  color: #666666;
}

.retry-btn {
  min-width: 180rpx;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 36rpx;
  background: #3088f4;
  color: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
}

.preview-image,
.preview-video {
  width: 100%;
  display: block;
  border-radius: 18rpx;
  background: #000000;
}

.preview-empty {
  min-height: 360rpx;
  border-radius: 18rpx;
  background: #fafbfc;
  color: #999999;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.fallback-tip {
  display: block;
  margin-bottom: 18rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #fff7e8;
  color: #ad6800;
  font-size: 22rpx;
  line-height: 1.6;
}

.card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.card-title {
  flex: 1;
  min-width: 0;
  font-size: 32rpx;
  line-height: 1.4;
  color: #1f1f1f;
  font-weight: 700;
}

.type-text {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #3088f4;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.action-btn.primary {
  background: #3088f4;
  color: #ffffff;
}

.action-btn.ghost {
  background: #e8f2fe;
  color: #3088f4;
}

.action-btn.disabled {
  background: #f2f4f7;
  color: #a0a5ad;
}

.action-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a7f87;
}

.danger-row {
  margin-top: 20rpx;
}

.danger-btn {
  min-height: 76rpx;
  padding: 0 20rpx;
  border-radius: 18rpx;
  background: #fff1f0;
  color: #d4380d;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 24rpx;
  font-weight: 600;
}

.danger-btn.disabled {
  background: #f2f4f7;
  color: #a0a5ad;
}

.danger-hint {
  display: block;
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #7a7f87;
}

.status-tag {
  min-width: 112rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.status-tag.permanent {
  background: #e8f5e9;
  color: #2e7d32;
}

.status-tag.temporary {
  background: #fff1f0;
  color: #d4380d;
}

.detail-list {
  gap: 14rpx;
  margin-top: 24rpx;
}

.detail-row {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
}

.detail-label {
  width: 112rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7a7f87;
}

.detail-value {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  line-height: 1.6;
  color: #333333;
  word-break: break-all;
}

.detail-value.mono {
  font-family: monospace;
}
