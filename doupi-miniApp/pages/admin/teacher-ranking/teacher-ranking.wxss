.page {
  min-height: 100vh;
  background: #F5F6F8;
  display: flex;
  flex-direction: column;
}

.search-bar {
  background: #fff;
  padding: 24rpx 32rpx;
  display: flex;
  gap: 16rpx;
  border-bottom: 2rpx solid #F5F6F8;
  position: relative;
}

.search-box {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 72rpx;
}

.search-clear {
  font-size: 30rpx;
  color: #999;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #F5F6F8;
  border-radius: 16rpx;
  padding: 0 24rpx;
  height: 72rpx;
  font-size: 24rpx;
  color: #333;
  white-space: nowrap;
}

.filter-dropdown {
  position: absolute;
  top: 100%;
  right: 32rpx;
  z-index: 100;
}

.dropdown-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: -1;
}

.dropdown-menu {
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.15);
  width: 240rpx;
  overflow: hidden;
  border: 2rpx solid #EEEEEE;
}

.dropdown-item {
  padding: 22rpx 28rpx;
  font-size: 26rpx;
  color: #333;
}

.dropdown-item.active {
  background: #E8F2FE;
  color: #3088F4;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 16rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.sort-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  white-space: nowrap;
}

.sort-tip {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #666666;
  line-height: 56rpx;
}

.sort-tabs {
  display: flex;
  gap: 16rpx;
  flex: 1;
  min-width: 0;
}

.sort-tab {
  min-width: 0;
  height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 2rpx solid #E8EAED;
  flex: 1;
  white-space: nowrap;
}

.sort-tab.active {
  background: #E8F2FE;
  border-color: #3088F4;
  color: #3088F4;
  font-weight: 600;
}

.teacher-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-top {
  display: flex;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.teacher-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background: #E8EAED;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.teacher-info {
  flex: 1;
  min-width: 0;
}

.info-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.teacher-name {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.status-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-tag.success {
  background: #F6FFED;
  color: #52C41A;
}

.status-tag.disabled {
  background: #F5F5F5;
  color: #999;
}

.teacher-phone {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-bottom: 6rpx;
}

.teacher-director {
  font-size: 24rpx;
  color: #888;
  display: block;
  margin-top: 4rpx;
  line-height: 1.4;
}

.rank-badge {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #FFB340, #FF8C00);
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.card-stats {
  display: flex;
  align-items: center;
  background: #FAFBFC;
  border-radius: 16rpx;
  padding: 24rpx 0;
  margin-bottom: 28rpx;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 34rpx;
  color: #3088F4;
  font-weight: 600;
  display: block;
  line-height: 1.3;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-top: 4rpx;
}

.stat-divider {
  width: 2rpx;
  height: 48rpx;
  background: #EEEEEE;
}

.card-actions {
  display: flex;
}

.btn-view {
  flex: 1;
  height: 72rpx;
  border-radius: 16rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 72rpx;
  border: 2rpx solid #3088F4;
  padding: 0;
  background: transparent;
  color: #3088F4;
}

.btn-view:active {
  background: #E8F2FE;
}

.empty {
  text-align: center;
  padding: 128rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  display: block;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 22rpx;
  color: #CCCCCC;
}
