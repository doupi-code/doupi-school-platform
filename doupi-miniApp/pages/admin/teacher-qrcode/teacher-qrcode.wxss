.page {
  min-height: 100vh;
  background: #F5F6F8;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}

.bind-tip {
  background: #FFF7E6;
  border: 2rpx solid #FFE7BA;
}

.bind-tip__title {
  font-size: 28rpx;
  color: #AD6800;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
}

.bind-tip__desc {
  font-size: 24rpx;
  color: #874D00;
  line-height: 1.6;
  display: block;
}

.bind-tip__actions {
  margin-top: 16rpx;
}

.bind-tip__btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 12rpx;
  border: none;
  background: #3088F4;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
}

.bind-tip__btn::after {
  border: none;
}

.bind-tip__btn:active {
  opacity: 0.85;
}

.teacher-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.teacher-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  background: #E8F2FE;
  color: #3088F4;
  font-size: 24rpx;
  text-align: center;
  line-height: 48rpx;
}

.teacher-name {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.teacher-role {
  display: block;
  font-size: 22rpx;
  color: #999;
}

.teacher-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
}

.teacher-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #666;
}

.teacher-value {
  font-size: 26rpx;
  color: #333;
}

.teacher-date {
  font-size: 22rpx;
  color: #999;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 700;
}

.section-title--metrics {
  line-height: 40rpx;
}

.center {
  text-align: center;
}

.qrcode-box {
  width: 100%;
  margin-top: 18rpx;
  border: 2rpx solid #EEE;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  text-align: center;
}

.qrcode-stage {
  position: relative;
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
}

.qrcode-skeleton {
  position: absolute;
  inset: 0;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #F2F3F5 0%, #E9EDF2 50%, #F2F3F5 100%);
  background-size: 200% 100%;
  animation: qrSkeletonLoading 1.2s ease-in-out infinite;
}

.qrcode-image {
  width: 420rpx;
  height: 420rpx;
  margin: 0 auto;
  position: relative;
  z-index: 1;
}

.qrcode-tip {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.qrcode-validity {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #666;
}

.qrcode-empty {
  background: #FAFAFA;
  border-style: dashed;
  border-color: #DDD;
}

.qrcode-empty-text {
  font-size: 28rpx;
  color: #666;
  line-height: 420rpx;
}

.tips-panel {
  margin-top: 16rpx;
  background: #FFF7E6;
  border-radius: 8rpx;
  padding: 12rpx;
}

.tips-title {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.tips-line {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 38rpx;
}

.btn-row {
  margin-top: 20rpx;
  display: flex;
  gap: 12rpx;
}

.btn {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  border: none;
  margin: 0;
  padding: 0 12rpx;
}

.btn::after {
  border: none;
}

.btn-primary {
  flex: 1;
  background: #3088F4;
  color: #FFF;
}

.btn-green {
  flex: 1;
  background: #52C41A;
  color: #FFF;
}

.btn-light {
  margin-top: 12rpx;
  width: 100%;
  background: #F5F6F8;
  color: #999;
}

.title-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
  min-height: 40rpx;
}

.title-row__icon-wrap {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.title-row__icon {
  display: block;
  line-height: 1;
}

.stats-grid {
  display: flex;
  align-items: stretch;
  gap: 12rpx;
}

.stat-box {
  border-radius: 8rpx;
  padding: 12rpx;
  flex: 1;
  min-width: 0;
  min-height: 132rpx;
  box-sizing: border-box;
}

.stat-loading {
  background: #F8FAFD;
}

.stat-blue { background: #E8F2FE; }
.stat-green { background: #F6FFED; }
.stat-orange { background: #FFF7E6; }
.stat-gray { background: #F5F6F8; }

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
}

.blue { color: #3088F4; }
.green { color: #52C41A; }
.orange { color: #FF8C00; }
.gray { color: #666; }

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #666;
  line-height: 1.4;
  margin-top: 4rpx;
}

.stat-skeleton {
  border-radius: 999rpx;
  background: linear-gradient(90deg, #F2F3F5 0%, #E9EDF2 50%, #F2F3F5 100%);
  background-size: 200% 100%;
  animation: qrSkeletonLoading 1.2s ease-in-out infinite;
}

.stat-skeleton-value {
  width: 88rpx;
  height: 36rpx;
  margin-bottom: 16rpx;
}

.stat-skeleton-label {
  width: 132rpx;
  height: 24rpx;
}

.conversion-row {
  margin-top: 16rpx;
  border-top: 1rpx solid #F5F6F8;
  padding-top: 16rpx;
  display: flex;
  justify-content: space-between;
}

.conversion-label {
  font-size: 26rpx;
  color: #666;
}

.conversion-value {
  font-size: 26rpx;
  color: #3088F4;
  font-weight: 700;
}

.warm-panel {
  background: #E8F2FE;
}

.warm-title {
  display: block;
  font-size: 26rpx;
  color: #333;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.warm-line {
  display: block;
  font-size: 24rpx;
  color: #666;
  line-height: 40rpx;
}

@keyframes qrSkeletonLoading {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}
