/**
 * 关于页样式 - 美化增强版
 * 设计规范：品牌展示、功能特色、联系方式
 */

.about-page { min-height: 100vh; background: #f5f6f8; }
.content { height: 100vh; padding: 16rpx; box-sizing: border-box; }
.card { background: #fff; border-radius: 12rpx; padding: 16rpx; margin-bottom: 16rpx; }
.card-title { display: block; font-size: 36rpx; color: #333; font-weight: 500; margin-bottom: 12rpx; }
.intro-image { width: 100%; height: 160rpx; border-radius: 8rpx; margin-bottom: 12rpx; }
.card-text { display: block; font-size: 28rpx; line-height: 1.65; color: #666; }
.contact-item { display: flex; align-items: center; gap: 12rpx; margin-bottom: 8rpx; }
.contact-icon { width: 40rpx; height: 40rpx; border-radius: 9999rpx; display: flex; align-items: center; justify-content: center; }
.contact-icon-image { width: 20rpx; height: 20rpx; }
.blue { background: #e8f2fe; } .orange { background: #fff7e6; } .green { background: #f6ffed; }
.contact-main { flex: 1; min-width: 0; }
.contact-label { display: block; font-size: 24rpx; color: #999; }
.contact-value { display: block; font-size: 32rpx; color: #333; word-break: break-all; }
.time-item { display: flex; justify-content: space-between; align-items: center; color: #666; font-size: 32rpx; padding: 8rpx 0; }
.time-divider { height: 1rpx; background: #f5f6f8; }
.rest { color: #999; }
