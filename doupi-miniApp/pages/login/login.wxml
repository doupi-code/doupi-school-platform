<view class="page">
  <view class="hero">
    <image class="hero-bg" src="/images/shared-hero-bg.png" mode="aspectFill" />
    <view class="hero-mask"></view>
    <view class="hero-icon-wrap">
      <image class="hero-icon" src="/images/icons/logo.png" mode="aspectFit" />
    </view>
    <text class="hero-title">汉外华襄预约小程序</text>
    <text class="hero-subtitle">专业的校园参观预约平台</text>
  </view>
  <view class="card">
    <text class="title">{{step === 'phone' ? '手机号登录' : '输入验证码'}}</text>
    <text class="desc">{{step === 'phone' ? '请输入手机号获取验证码' : ('验证码已发送至 ' + phone)}}</text>
    <block wx:if="{{step === 'phone'}}">
      <view class="input-wrap">
        <text class="prefix">+86</text>
        <input class="phone-input" type="number" maxlength="11" placeholder="请输入手机号"
          value="{{phone}}" bindinput="handlePhoneInput" disabled="{{sendingCode || loggingIn || wechatLoggingIn}}" />
      </view>
      <view class="agreement-line" bindtap="toggleAgreement">
        <view class="checkbox {{agreed ? 'checkbox--checked' : ''}}"></view>
        <text class="agreement-text">我已阅读并同意</text>
        <text class="link" catchtap="goToPrivacy">《隐私政策》</text>
        <text class="agreement-text">和</text>
        <text class="link" catchtap="goToAgreement">《用户协议》</text>
      </view>
      <text class="error-text" wx:if="{{error}}">{{error}}</text>
      <button class="primary-btn" bindtap="handleSendCode" disabled="{{sendingCode || wechatLoggingIn}}"
        loading="{{sendingCode}}">获取验证码</button>
    </block>
    <block wx:else>
      <view class="input-wrap">
        <input class="phone-input" type="number" maxlength="6" placeholder="请输入6位验证码"
          value="{{code}}" bindinput="handleCodeInput" disabled="{{sendingCode || loggingIn || wechatLoggingIn}}" />
      </view>
      <text class="error-text" wx:if="{{error}}">{{error}}</text>
      <view class="code-actions">
        <text class="link" bindtap="handleChangePhone">修改手机号</text>
        <text class="agreement-text" wx:if="{{countdown > 0}}">{{countdown}}s</text>
        <text class="link" wx:else bindtap="handleSendCode">{{sendingCode ? '发送中…' : '重新获取'}}</text>
      </view>
      <button class="primary-btn" bindtap="handleLogin" disabled="{{sendingCode || loggingIn || wechatLoggingIn || code.length !== 6}}"
        loading="{{loggingIn}}">登录</button>
    </block>
    <view class="other-login">
      <view class="line"></view>
      <text class="other-text">手机号快捷登录</text>
      <view class="line"></view>
    </view>
    <view class="quick-login-btn-wrap">
      <button wx:if="{{agreed}}" class="primary-btn quick-login-btn" open-type="getPhoneNumber"
        bindgetphonenumber="handleWechatQuickLogin" disabled="{{sendingCode || loggingIn || wechatLoggingIn}}"
        loading="{{wechatLoggingIn}}">手机号快捷登录</button>
      <button wx:else class="primary-btn quick-login-btn" bindtap="requireAgreement">手机号快捷登录</button>
    </view>
    <button class="decline-login-btn" bindtap="decline" disabled="{{sendingCode || loggingIn || wechatLoggingIn}}">暂不登录，返回原页面</button>
  </view>
</view>
