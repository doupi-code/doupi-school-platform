<view class="pc-page">
  <!-- 与「我的」页一致的顶栏渐变 + 头像区 -->
  <view class="pc-header">
    <view class="pc-header__inner">
      <button class="pc-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
        <view class="pc-avatar-wrap">
          <image
            class="pc-avatar-img"
            src="{{avatarDisplay}}"
            mode="aspectFill"
          />
        </view>
        <text class="pc-avatar-tip">点击设置头像</text>
      </button>
      <text class="pc-header__title">完善资料</text>
      <text class="pc-header__sub">保存成功后才算登录，可正常使用预约等功能</text>
    </view>
  </view>

  <scroll-view scroll-y class="pc-scroll" enhanced show-scrollbar="{{false}}">
    <view class="pc-body">
      <view class="pc-card">
        <view class="pc-card__head">
          <t-icon name="user" size="32rpx" color="#3088F4" />
          <text class="pc-card__title">基本信息</text>
        </view>
        <view class="pc-field-row">
          <text class="pc-field-label">昵称</text>
          <input
            class="pc-field-input"
            type="nickname"
            maxlength="20"
            placeholder="请输入昵称"
            value="{{nickname}}"
            bindinput="onNicknameInput"
          />
        </view>
        <text class="pc-err" wx:if="{{errors.nickname}}">{{errors.nickname}}</text>
        <text class="pc-err" wx:if="{{errors.avatar}}">{{errors.avatar}}</text>
      </view>

      <view class="pc-card" wx:if="{{!phoneFromWx}}">
        <view class="pc-card__head">
          <t-icon name="call" size="32rpx" color="#3088F4" />
          <text class="pc-card__title">绑定手机号</text>
        </view>
        <view class="pc-input-wrap">
          <text class="pc-prefix">+86</text>
          <input
            class="pc-phone-input"
            type="number"
            maxlength="11"
            placeholder="请输入手机号"
            value="{{phone}}"
            bindinput="onPhoneInput"
          />
        </view>
        <text class="pc-err" wx:if="{{errors.phone}}">{{errors.phone}}</text>

        <button
          class="pc-wx-phone"
          open-type="getPhoneNumber"
          bindgetphonenumber="onWxGetPhone"
          disabled="{{wxPhoneLoading}}"
          hover-class="pc-wx-phone--hover"
        >
          {{wxPhoneLoading ? '授权中...' : '授权获取手机号'}}
        </button>

        <text class="pc-code-desc" wx:if="{{showCodeHint}}">{{codeHintText}}</text>

        <view class="pc-code-row">
          <input
            class="pc-code-inp"
            type="number"
            maxlength="6"
            placeholder="6位短信验证码"
            value="{{code}}"
            bindinput="onCodeInput"
          />
          <button
            class="pc-send"
            bindtap="handleSendCode"
            disabled="{{sendingCode || countdown > 0}}"
            hover-class="pc-send--hover"
          >
            {{countdown > 0 ? countdown + 's' : (sendingCode ? '发送中' : '获取验证码')}}
          </button>
        </view>
        <text class="pc-err" wx:if="{{errors.code}}">{{errors.code}}</text>
      </view>

      <view class="pc-card" wx:else>
        <view class="pc-card__head">
          <t-icon name="check-circle" size="32rpx" color="#52C41A" />
          <text class="pc-card__title">手机号</text>
        </view>
        <view class="pc-locked">已授权 {{maskedPhone}}</view>
      </view>

      <view class="pc-card pc-card--foot">
        <view class="agreement-line" bindtap="onAgreedTap" data-checked="{{!agreed}}">
          <view class="checkbox {{agreed ? 'checkbox--checked' : ''}}"></view>
          <text class="agreement-text">我已阅读并同意</text>
          <text class="link" catchtap="goPrivacy">《隐私政策》</text>
          <text class="agreement-text">和</text>
          <text class="link" catchtap="goAgreement">《用户协议》</text>
        </view>
        <text class="pc-err" wx:if="{{errors.agreed}}">{{errors.agreed}}</text>

        <button class="pc-save" bindtap="onSave" disabled="{{saving}}">
          {{saving ? '保存中...' : '保存并进入'}}
        </button>
      </view>
    </view>
  </scroll-view>
</view>
