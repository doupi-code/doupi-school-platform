<view class="page">
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}" bindscrolltolower="loadMore">
    
    <!-- 空状态 -->
    <view wx:if="{{!notifications.length && !loading}}" class="empty-state">
      <view class="empty-illustration">
        <t-icon name="notification" size="120rpx" color="#D9D9D9"></t-icon>
      </view>
      <text class="empty-title">{{displayText.noMessages}}</text>
      <text class="empty-desc">{{displayText.emptyNoNotificationDesc}}</text>
    </view>

    <!-- 消息列表 -->
    <block wx:else>
      <!-- 今天 -->
      <block wx:if="{{todayNotifications.length > 0}}">
        <view class="date-group-header">
          <view class="date-line"></view>
          <text class="date-label">{{displayText.labelToday}}</text>
          <view class="date-line"></view>
        </view>
        <view class="notice-list">
          <view
            class="notice-item {{item.read ? '' : 'unread'}}"
            wx:for="{{todayNotifications}}"
            wx:key="id"
            data-id="{{item.id}}"
            data-index="{{item.index}}"
            bindtap="handleTapNotification"
          >
            <view class="notice-icon-wrap {{item.type === 'system' ? 'system' : 'appointment'}}">
              <t-icon name="{{item.type === 'system' ? 'notification' : 'calendar'}}" size="32rpx" color="#ffffff"></t-icon>
            </view>
            <view class="notice-content">
              <view class="notice-top">
                <text class="notice-title">{{item.title}}</text>
                <view class="unread-dot" wx:if="{{!item.read}}"></view>
              </view>
              <text class="notice-desc">{{item.content}}</text>
              <view class="notice-bottom">
                <text class="notice-time">{{item.time}}</text>
                <view class="notice-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
              </view>
            </view>
          </view>
        </view>
      </block>

      <!-- 更早 -->
      <block wx:if="{{earlierNotifications.length > 0}}">
        <view class="date-group-header">
          <view class="date-line"></view>
          <text class="date-label">{{displayText.labelEarlier}}</text>
          <view class="date-line"></view>
        </view>
        <view class="notice-list">
          <view
            class="notice-item"
            wx:for="{{earlierNotifications}}"
            wx:key="id"
            data-id="{{item.id}}"
            data-index="{{item.index}}"
            bindtap="handleTapNotification"
          >
            <view class="notice-icon-wrap read-icon {{item.type === 'system' ? 'system' : 'appointment'}}">
              <t-icon name="{{item.type === 'system' ? 'notification' : 'calendar'}}" size="32rpx" color="#ffffff" opacity="0.7"></t-icon>
            </view>
            <view class="notice-content">
              <view class="notice-top">
                <text class="notice-title notice-title--read">{{item.title}}</text>
              </view>
              <text class="notice-desc notice-desc--read">{{item.content}}</text>
              <view class="notice-bottom">
                <text class="notice-time notice-time--read">{{item.time}}</text>
              </view>
            </view>
          </view>
        </view>
      </block>
    </block>

    <!-- 加载更多提示 -->
    <view wx:if="{{hasMore}}" class="load-more-tip">
      <text>{{displayText.loadMorePullUp}}</text>
    </view>

    <!-- 已经到底了 -->
    <view wx:if="{{!hasMore && notifications.length > 0}}" class="no-more-tip">
      <view class="no-more-line"></view>
      <text class="no-more-text">{{displayText.noMoreReached}}</text>
      <view class="no-more-line"></view>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 底部「全部已读」：固定占位，避免列表高度算错后出现灰条遮挡；无未读时仍可看到入口（置灰） -->
  <view class="mark-all-footer" wx:if="{{notifications.length > 0}}">
    <view
      class="mark-all-btn {{hasUnread ? '' : 'mark-all-btn--disabled'}}"
      bindtap="markAllRead"
      hover-class="{{hasUnread ? 'mark-all-btn--active' : 'none'}}"
    >
      <text class="mark-all-btn-text">{{displayText.btnMarkAllRead}}</text>
    </view>
  </view>
</view>
