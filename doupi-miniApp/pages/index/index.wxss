page {
  height: 100vh;
  background: #F5F6F8;
}

.home-page {
  height: 100vh;
  background-color: #F5F6F8;
  overflow: hidden;
}

.loading-wrap {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-content {
  height: calc(100vh - 112rpx);
  height: calc(100vh - 112rpx - env(safe-area-inset-bottom));
  height: calc(100vh - 112rpx - constant(safe-area-inset-bottom));
  width: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  row-gap: 8rpx;
}

.hero-swiper {
  width: 100%;
  flex: 256;
  min-height: 360rpx;
  position: relative;
  overflow: hidden;
}

.hero-swiper__inner {
  width: 100%;
  height: 100%;
}

.hero-image {
  width: 100%;
  height: 100%;
  display: block;
}

.hero-dots {
  position: absolute;
  left: 50%;
  bottom: 24rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  pointer-events: none;
}

.hero-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.55);
}

.hero-dot--active {
  background: #FFFFFF;
}

.hero-placeholder {
  flex: 256;
  min-height: 360rpx;
  background: linear-gradient(180deg, #cfe2f8 0%, #f5f6f8 100%);
}

.section {
  background-color: #FFFFFF;
  padding: 32rpx;
  box-sizing: border-box;
}

.section-campus {
  flex: 332;
  min-height: 432rpx;
}

.section-quick {
  flex: 168;
  min-height: 256rpx;
}

.section-title {
  font-size: 40rpx;
  line-height: 60rpx;
  color: #333333;
  font-weight: 500;
  display: block;
  margin-bottom: 24rpx;
}

.campus-card {
  border-radius: 24rpx;
  overflow: hidden;
  border: 2rpx solid #EEEEEE;
  background: #FFFFFF;
  height: auto;
  display: flex;
  flex-direction: column;
}

.campus-image {
  width: 100%;
  height: 240rpx;
  display: block;
  flex-shrink: 0;
}

/* 兼容 t-image 内部 image */
.campus-image-placeholder {
  background: #EAF2FC;
}

.campus-content {
  padding: 24rpx 24rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.campus-cell {
  padding: 0 !important;
  background: transparent !important;
}

.campus-cell__title {
  color: #333333 !important;
  font-size: 36rpx !important;
  line-height: 54rpx !important;
  font-weight: 700 !important;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.campus-cell__desc {
  margin-top: 14rpx;
  color: #666666 !important;
  font-size: 28rpx !important;
  line-height: 40rpx !important;
  display: block;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  height: 40rpx;
}

.quick-grid {
  display: flex;
  justify-content: space-between;
  height: calc(100% - 84rpx);
}

.quick-item {
  width: 331rpx;
  height: 168rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  box-sizing: border-box;
}

.quick-item-light {
  background: #F0F1F4;
}

.quick-item-blue {
  background: #E8F2FE;
}

.quick-item-active {
  opacity: 0.8;
}

.quick-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
}

.quick-icon-image {
  width: 42rpx;
  height: 42rpx;
}

.quick-icon-gray {
  background: #6B6B6B;
}

.quick-icon-primary {
  background: #3088F4;
}

.quick-text {
  font-size: 34rpx;
  line-height: 40rpx;
  color: #333333;
  font-weight: 500;
}
