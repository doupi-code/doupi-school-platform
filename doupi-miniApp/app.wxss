/**
 * 全局样式 - 汉外华襄预约小程序
 * 设计系统规范 v2.0
 *
 * 包含：
 * 1. CSS 变量定义（设计令牌）
 * 2. 基础重置样式
 * 3. 通用工具类（Flexbox、间距、文本、颜色、圆角等）
 * 4. 组件基础样式（按钮、输入框、卡片、标签等）
 * 5. 响应式和安全区域支持
 */

/* ==================== 引入设计系统变量 ==================== */
@import './styles/theme.wxss';

/* ==================== 引入 TDesign 图标样式（t-icon） ==================== */
@import './miniprogram_npm/tdesign-miniprogram/icon/icon.wxss';

/* ==================== 基础重置样式 ==================== */
page {
  /* 继承 theme.wxss 中的所有变量 */
  background-color: var(--background);
  font-family: var(--font-family);
  font-size: var(--font-size-base);
  color: var(--text-primary);
  line-height: var(--line-height-normal);
  box-sizing: border-box;
}

view, text, image, button, input, textarea, scroll-view {
  box-sizing: border-box;
}

/* ==================== 布局容器 ==================== */
.container {
  padding: 0 var(--page-padding-x);
}

.page-wrapper {
  min-height: 100vh;
  background-color: var(--background);
  display: flex;
  flex-direction: column;
}

/* ==================== Flexbox 工具类 ==================== */
.flex { display: flex; }
.flex-col { flex-direction: column; }
.flex-row { flex-direction: row; }
.flex-wrap { flex-wrap: wrap; }
.flex-1 { flex: 1; }
.flex-auto { flex: auto; }
.flex-none { flex: none; }

/* 对齐方式 */
.items-start { align-items: flex-start; }
.items-center { align-items: center; }
.items-end { align-items: flex-end; }
.items-stretch { align-items: stretch; }
.items-baseline { align-items: baseline; }

.justify-start { justify-content: flex-start; }
.justify-center { justify-content: center; }
.justify-end { justify-content: flex-end; }
.justify-between { justify-content: space-between; }
.justify-around { justify-content: space-around; }
.justify-evenly { justify-content: space-evenly; }

/* 快捷组合 */
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ==================== 间距工具类（Gap）==================== */
.gap-xs { gap: var(--spacing-xs); }    /* 8rpx */
.gap-sm { gap: var(--spacing-sm); }    /* 16rpx */
.gap-md { gap: var(--spacing-md); }    /* 24rpx */
.gap-base { gap: var(--spacing-base); } /* 32rpx */
.gap-lg { gap: var(--spacing-lg); }    /* 48rpx */
.gap-xl { gap: var(--spacing-xl); }    /* 64rpx */

/* 兼容旧版 */
.gap-2 { gap: 16rpx; }
.gap-3 { gap: 24rpx; }

/* ==================== 内边距工具类（Padding）==================== */
/* 四边统一内边距 */
.p-xs { padding: var(--spacing-xs); }   /* 8rpx */
.p-sm { padding: var(--spacing-sm); }   /* 16rpx */
.p-md { padding: var(--spacing-md); }   /* 24rpx */
.p-base { padding: var(--spacing-base); } /* 32rpx */
.p-lg { padding: var(--spacing-lg); }   /* 48rpx */
.p-xl { padding: var(--spacing-xl); }   /* 64rpx */

/* 水平内边距 */
.px-xs { padding-left: var(--spacing-xs); padding-right: var(--spacing-xs); }
.px-sm { padding-left: var(--spacing-sm); padding-right: var(--spacing-sm); }
.px-md { padding-left: var(--spacing-md); padding-right: var(--spacing-md); }
.px-base { padding-left: var(--spacing-base); padding-right: var(--spacing-base); }
.px-lg { padding-left: var(--spacing-lg); padding-right: var(--spacing-lg); }

/* 垂直内边距 */
.py-xs { padding-top: var(--spacing-xs); padding-bottom: var(--spacing-xs); }
.py-sm { padding-top: var(--spacing-sm); padding-bottom: var(--spacing-sm); }
.py-md { padding-top: var(--spacing-md); padding-bottom: var(--spacing-md); }
.py-base { padding-top: var(--spacing-base); padding-bottom: var(--spacing-base); }
.py-lg { padding-top: var(--spacing-lg); padding-bottom: var(--spacing-lg); }

/* 兼容旧版 */
.p-3 { padding: 24rpx; }
.p-4 { padding: 32rpx; }
.px-4 { padding-left: 32rpx; padding-right: 32rpx; }
.py-3 { padding-top: 24rpx; padding-bottom: 24rpx; }

/* ==================== 外边距工具类（Margin）==================== */
/* 上边距 */
.mt-xs { margin-top: var(--spacing-xs); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-base { margin-top: var(--spacing-base); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

/* 下边距 */
.mb-xs { margin-bottom: var(--spacing-xs); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-base { margin-bottom: var(--spacing-base); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

/* 左右边距 */
.mx-auto { margin-left: auto; margin-right: auto; }

/* 兼容旧版 */
.mt-2 { margin-top: 16rpx; }
.mt-3 { margin-top: 24rpx; }
.mt-4 { margin-top: 32rpx; }
.mb-2 { margin-bottom: 16rpx; }
.mb-3 { margin-bottom: 24rpx; }
.mb-4 { margin-bottom: 32rpx; }

/* ==================== 文本工具类 ==================== */
/* 对齐 */
.text-left { text-align: left; }
.text-center { text-align: center; }
.text-right { text-align: right; }

/* 颜色 - 使用设计变量 */
.text-primary { color: var(--text-primary); }
.text-secondary { color: var(--text-secondary); }
.text-tertiary { color: var(--text-tertiary); }
.text-placeholder { color: var(--text-placeholder); }
.text-disabled { color: var(--text-disabled); }
.text-white { color: var(--text-white); }
.text-brand { color: var(--primary); }
.text-success { color: var(--success); }
.text-warning { color: var(--warning); }
.text-error { color: var(--error); }
.text-info { color: var(--info); }

/* 字号 - 使用设计变量 */
.text-xs { font-size: var(--font-size-xs); }     /* 20rpx */
.text-sm { font-size: var(--font-size-sm); }     /* 24rpx */
.text-base { font-size: var(--font-size-base); } /* 28rpx */
.text-md { font-size: var(--font-size-md); }     /* 32rpx */
.text-lg { font-size: var(--font-size-lg); }     /* 36rpx */
.text-xl { font-size: var(--font-size-xl); }     /* 44rpx */

/* 兼容旧版 */
.text-sm-old { font-size: 24rpx; }
.text-xs-old { font-size: 20rpx; }
.text-lg-old { font-size: 32rpx; }
.text-xl-old { font-size: 36rpx; }

/* 字重 */
.font-normal { font-weight: var(--font-weight-regular); }
.font-medium { font-weight: var(--font-weight-medium); }
.font-semibold { font-weight: var(--font-weight-semibold); }
.font-bold { font-weight: var(--font-weight-bold); }

/* 行高 */
.leading-tight { line-height: var(--line-height-tight); }
.leading-normal { line-height: var(--line-height-normal); }
.leading-relaxed { line-height: var(--line-height-relaxed); }

/* 文本溢出 */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.text-clamp-3 {
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ==================== 背景色工具类 ==================== */
.bg-transparent { background-color: transparent; }
.bg-white { background-color: #FFFFFF; }
.bg-page { background-color: var(--background); }
.bg-brand { background-color: var(--primary); }
.bg-brand-light { background-color: var(--primary-light); }
.bg-brand-hover { background-color: var(--primary-hover); }
.bg-success-light { background-color: var(--success-light); }
.bg-warning-light { background-color: var(--warning-light); }
.bg-error-light { background-color: var(--error-light); }
.bg-info-light { background-color: var(--info-light); }

/* ==================== 圆角工具类 ==================== */
.rounded-none { border-radius: 0; }
.rounded-xs { border-radius: var(--radius-xs); }   /* 8rpx */
.rounded-sm { border-radius: var(--radius-sm); }   /* 12rpx */
.rounded-base { border-radius: var(--radius-base); } /* 16rpx */
.rounded-lg { border-radius: var(--radius-lg); }   /* 24rpx */
.rounded-xl { border-radius: var(--radius-xl); }   /* 32rpx */
.rounded-full { border-radius: var(--radius-pill); } /* 9999rpx - 胶囊形 */
.rounded-circle { border-radius: var(--radius-round); } /* 50% - 圆形 */

/* 兼容旧版 */
.rounded-lg-old { border-radius: 16rpx; }
.rounded-xl-old { border-radius: 24rpx; }

/* ==================== 尺寸工具类 ==================== */
.w-full { width: 100%; }
.w-screen { width: 100vw; }
.h-full { height: 100%; }
.h-screen { height: 100vh; }

/* ==================== 边框工具类 ==================== */
.border { border: 1px solid var(--border-color); }
.border-top { border-top: 1px solid var(--border-color); }
.border-right { border-right: 1px solid var(--border-color); }
.border-bottom { border-bottom: 1px solid var(--border-color); }
.border-left { border-left: 1px solid var(--border-color); }
.border-0 { border: none; }

.border-bottom-thin {
  border-bottom: 1rpx solid var(--border-color);
}

/* ==================== 阴影工具类 ==================== */
.shadow-sm { box-shadow: var(--shadow-sm); }
.shadow-base { box-shadow: var(--shadow-base); }
.shadow-md { box-shadow: var(--shadow-md); }
.shadow-lg { box-shadow: var(--shadow-lg); }
.shadow-card { box-shadow: var(--shadow-card); }

/* ==================== 溢出工具类 ==================== */
.overflow-hidden { overflow: hidden; }
.overflow-auto { overflow: auto; }
.overflow-scroll { overflow: scroll; }

/* ==================== 定位工具类 ==================== */
.relative { position: relative; }
.absolute { position: absolute; }
.fixed { position: fixed; }
.sticky { position: sticky; }

/* ==================== 统一按钮样式 ==================== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-base);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-medium);
  border: none;
  line-height: normal;
  transition: all var(--transition-fast);
  cursor: pointer;
}

/* 按钮尺寸 */
.btn-sm {
  height: 64rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  border-radius: var(--radius-sm);
}

.btn-md {
  height: 88rpx;
  padding: 0 32rpx;
  font-size: 30rpx;
  border-radius: var(--radius-base);
}

.btn-lg {
  height: 96rpx;
  padding: 0 40rpx;
  font-size: 32rpx;
  border-radius: var(--radius-base);
}

/* 按钮类型 - 主色按钮 */
.btn-primary,
.btn-primary.btn-md,
.btn-primary.btn-lg {
  background-color: var(--primary);
  color: #FFFFFF;
}

.btn-primary:active {
  background-color: var(--primary-hover);
}

/* 次级按钮 */
.btn-secondary {
  background-color: var(--background);
  color: var(--text-primary);
}

.btn-secondary:active {
  background-color: var(--divider-color);
}

/* 危险按钮 */
.btn-danger {
  background-color: var(--error);
  color: #FFFFFF;
}

.btn-danger:active {
  background-color: var(--error-hover);
}

/* 文字按钮 */
.btn-text {
  background-color: transparent;
  color: var(--primary);
  padding: 0;
  height: auto;
}

.btn-text:active {
  opacity: 0.7;
}

/* 幽灵按钮（带边框） */
.btn-ghost {
  background-color: transparent;
  color: var(--primary);
  border: 2rpx solid var(--primary);
}

.btn-ghost:active {
  background-color: var(--primary-light);
}

/* 禁用状态 */
.btn-disabled,
.btn[disabled] {
  opacity: 0.5;
  pointer-events: none;
}

/* 全宽按钮 */
.btn-block {
  width: 100%;
}

/* ==================== 统一输入框样式 ==================== */
.input-base {
  width: 100%;
  height: 88rpx;
  background-color: var(--background);
  border-radius: var(--radius-base);
  padding: 0 24rpx;
  font-size: var(--font-size-base);
  color: var(--text-primary);
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all var(--transition-fast);
}

.input-base:focus {
  background-color: #FFFFFF;
  border-color: var(--primary);
}

.input-base::placeholder {
  color: var(--text-placeholder);
}

/* 输入框组 */
.input-group {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-sm);
}

.input-label {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-xs);
}

.input-error {
  font-size: var(--font-size-xs);
  color: var(--error);
  margin-top: var(--spacing-xs);
}

/* ==================== 统一卡片样式 ==================== */
.card {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.card-padding {
  padding: var(--spacing-base);
}

.card-no-shadow {
  box-shadow: none;
}

/* 卡片标题 */
.card-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  margin-bottom: var(--spacing-md);
}

/* ==================== 统一状态标签样式 ==================== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: var(--radius-xs);
  font-size: var(--font-size-xs);
  line-height: 1.5;
  white-space: nowrap;
}

.tag-success {
  background-color: var(--success-light);
  color: var(--success);
  border: 2rpx solid #B7EB8F;
}

.tag-warning {
  background-color: var(--warning-light);
  color: var(--warning);
  border: 2rpx solid #FFD591;
}

.tag-error {
  background-color: var(--error-light);
  color: var(--error);
  border: 2rpx solid #FFCCC7;
}

.tag-info {
  background-color: var(--info-light);
  color: var(--info);
  border: 2rpx solid #91D5FF;
}

.tag-default {
  background-color: #F5F5F5;
  color: var(--text-secondary);
  border: 2rpx solid #E5E5E5;
}

.tag-disabled {
  background-color: #F5F5F5;
  color: var(--text-tertiary);
  border: 2rpx solid #D9D9D9;
}

/* ==================== 列表项样式 ==================== */
.list-item {
  display: flex;
  align-items: center;
  padding: var(--spacing-base) var(--page-padding-x);
  background-color: var(--card-bg);
  transition: background-color var(--transition-fast);
}

.list-item:active {
  background-color: var(--background);
}

.list-item-content {
  flex: 1;
  min-width: 0;
}

.list-item-arrow {
  width: 32rpx;
  height: 32rpx;
  margin-left: var(--spacing-sm);
  opacity: 0.3;
}

/* 列表分割线 */
.divider {
  height: 2rpx;
  background-color: var(--divider-color);
}

.divider-thick {
  height: 16rpx;
  background-color: var(--background);
}

/* ==================== 页面头部通用样式 ==================== */
.page-header {
  background-color: var(--card-bg);
  padding: var(--spacing-base);
  flex-shrink: 0;
}

.header-title {
  font-size: var(--font-size-lg);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
}

/* ==================== 表单区域通用样式 ==================== */
.form-section {
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-base);
  margin-bottom: var(--spacing-base);
}

.section-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  display: block;
  margin-bottom: var(--spacing-base);
}

.form-item {
  margin-bottom: var(--spacing-base);
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  display: block;
  margin-bottom: var(--spacing-sm);
}

.required {
  color: var(--error);
  margin-left: 4rpx;
}

/* ==================== 信息展示行 ==================== */
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  flex-shrink: 0;
  min-width: 140rpx;
}

.info-value {
  font-size: var(--font-size-sm);
  color: var(--text-primary);
  flex: 1;
}

.info-value-right {
  text-align: right;
}

/* 时间戳样式 */
.time-text {
  font-size: var(--font-size-xs);
  color: var(--text-tertiary);
}

/* ==================== 模态框通用样式 ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: var(--z-modal-backdrop);
}

.modal-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  max-width: 90vw;
  max-height: 80vh;
  overflow-y: auto;
  background-color: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  z-index: var(--z-modal);
}

.modal-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-medium);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-sm);
}

.modal-desc {
  font-size: var(--font-size-sm);
  color: var(--text-secondary);
  display: block;
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.modal-actions {
  display: flex;
  gap: var(--spacing-md);
}

/* ==================== 安全区域支持（异形屏/刘海屏适配）==================== */
/*
 * 安全区域工具类说明：
 * - 使用 env() 函数获取设备的安全区域尺寸
 * - 适用于 iPhone X 及以上、刘海屏 Android 设备等
 * - 不支持 safe-area 的设备会自动降级为 0，不会影响布局
 *
 * 使用场景：
 * - .safe-area-top: 用于固定在顶部的元素（如自定义导航栏）
 * - .safe-area-bottom: 用于固定在底部的元素（如底部按钮栏、TabBar 替代品）
 * - .safe-area-left/.safe-area-right: 用于横屏时的左右安全区域
 * - .nav-bar-safe-top: 用于自定义导航栏的顶部间距（状态栏 + 导航栏高度）
 * - .custom-nav-bar: 自定义导航栏容器的完整样式
 */

/* 单方向安全区域内边距 */
.safe-area-top {
  padding-top: env(safe-area-inset-top);
}

.safe-area-left {
  padding-left: env(safe-area-inset-left);
}

.safe-area-right {
  padding-right: env(safe-area-inset-right);
}

/* 导航栏安全区域（状态栏高度 + 导航栏高度） */
.nav-bar-safe-top {
  padding-top: calc(env(safe-area-inset-top) + var(--nav-bar-height));
}

/* 底部安全区域（带基础间距）- 用于页面底部内容 */
.safe-area-bottom {
  padding-bottom: calc(var(--spacing-base) + env(safe-area-inset-bottom));
}

/* 底部占位元素 - 用于为固定底部的元素预留空间 */
.bottom-spacer {
  height: calc(40rpx + env(safe-area-inset-bottom));
}

/* ==================== 自定义导航栏组件样式 ==================== */
/*
 * 使用方法：
 * 1. 在页面的 JSON 配置中设置 "navigationStyle": "custom"
 * 2. 在页面 WXML 的最外层使用 .custom-nav-bar 类
 * 3. 在 .custom-nav-bar 内部使用 .custom-nav-bar-content 放置导航栏内容
 *
 * 示例结构：
 * <view class="custom-nav-bar">
 *   <view class="custom-nav-bar-content">
 *     <text>标题</text>
 *   </view>
 * </view>
 * <view class="page-content" style="padding-top: XXpx;"> <!-- 根据实际导航栏高度设置 -->
 *   <!-- 页面内容 -->
 * </view>
 */

.custom-nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: var(--z-fixed);
  /* 状态栏安全区域 */
  padding-top: env(safe-area-inset-top);
  background-color: #FFFFFF;
  /* 平滑过渡背景色 */
  transition: background-color var(--transition-fast);
}

/* 支持透明/半透明背景的自定义导航栏 */
.custom-nav-bar.transparent {
  background-color: transparent;
}

.custom-nav-bar.blur {
  backdrop-filter: blur(10px);
  background-color: rgba(255, 255, 255, 0.85);
}

/* 自定义导航栏内容区域 */
.custom-nav-bar-content {
  height: var(--nav-bar-height);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  /* 确保内容不被裁剪 */
  overflow: hidden;
}

/* 导航栏标题 */
.custom-nav-bar-title {
  font-size: var(--font-size-md);
  color: var(--text-primary);
  font-weight: var(--font-weight-semibold);
  text-align: center;
  /* 文本溢出省略 */
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 60%;
}

/* 导航栏左侧操作区（返回按钮等） */
.custom-nav-bar-left {
  position: absolute;
  left: var(--spacing-sm);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

/* 导航栏右侧操作区（分享、更多等） */
.custom-nav-bar-right {
  position: absolute;
  right: var(--spacing-sm);
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: var(--spacing-xs);
}

/* ==================== 过渡动画辅助类 ==================== */
.transition-all {
  transition: all var(--transition-base);
}

.transition-colors {
  transition: color var(--transition-fast), background-color var(--transition-fast), border-color var(--transition-fast);
}

/* ==================== 可访问性辅助类 ==================== */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border-width: 0;
}

/* 高对比度模式支持 */
@media (prefers-contrast: high) {
  .btn-primary {
    border: 2rpx solid #000000;
  }

  .tag-success,
  .tag-warning,
  .tag-error,
  .tag-info {
    border-width: 4rpx;
  }
}
/* 减少动画偏好 */
@media (prefers-reduced-motion: reduce) {
  view, text, button, image, input, form, page, navigator {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
