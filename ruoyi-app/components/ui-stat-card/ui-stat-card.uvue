    <image v-if="icon != ''" class="ui-stat-card__icon" :src="icon" mode="aspectFit"></image>
  </view>
</template>

<script lang="uts">
export default {
  name: 'UiStatCard',
  props: {
    title: {
      type: String,
      default: ''
    },
    value: {
