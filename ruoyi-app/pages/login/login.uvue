<template>
  <view class="login-container">
    <!-- 顶部品牌渐变大屏 -->
    <view class="hero-header">
      <view class="hero-content">
        <image class="brand-logo" src="/static/logo.png" mode="aspectFit"></image>
        <text class="brand-title">豆皮智慧校园</text>
        <text class="brand-slogan">移动管理协同工作台 · 纯血鸿蒙/全端原生</text>
      </view>
    </view>

    <!-- 悬浮拟物登录白卡 -->
    <view class="form-wrapper">
      <view class="form-card">
        <view class="card-header">
          <text class="login-type-title">账号密码登录</text>
          <text class="login-type-sub">教职员工与管理人员专属入口</text>
        </view>

        <!-- 账号输入 (up-input) -->
        <view class="u-input-wrapper">
          <up-input 
            v-model="form.username" 
            placeholder="请输入账号 / 工号" 
            prefixIcon="/static/icons/settings-user.svg"
            prefixIconStyle="width: 18px; height: 18px; margin-right: 8px;"
            border="surround"
            shape="circle"
            clearable
          ></up-input>
        </view>

        <!-- 密码输入 (up-input) -->
        <view class="u-input-wrapper">
          <up-input 
            v-model="form.password" 
            type="password" 
            password
            placeholder="请输入登录密码" 
            prefixIcon="/static/icons/settings-lock.svg"
            prefixIconStyle="width: 18px; height: 18px; margin-right: 8px;"
            border="surround"
            shape="circle"
            clearable
          ></up-input>
        </view>

        <!-- 验证码 -->
        <view class="input-group captcha-group" v-if="captchaEnabled">
          <image class="input-icon-svg" src="/static/icons/shield.png" mode="aspectFit"></image>
          <input 
            class="native-input captcha-input" 
            v-model="form.code" 
            placeholder="验证码" 
            placeholder-style="color: #86909c;" 
          />
          <image class="captcha-badge" :src="captchaUrl" @click="fetchCaptcha" mode="aspectFit"></image>
        </view>

        <!-- 记住状态与辅助操作 -->
        <view class="helper-row">
          <view class="remember-box" @click="toggleRemember">
            <view :class="['custom-check', form.rememberMe ? 'check-active' : '']">
              <text v-if="form.rememberMe" class="check-tick">✓</text>
            </view>
            <text class="helper-text">自动记住账号</text>
          </view>
          <text class="forget-link">忘记密码?</text>
        </view>

        <!-- 主操作按钮：使用全新导入的 uview-ultra 官方组件库 up-button -->
        <up-button 
          type="primary" 
          shape="circle" 
          size="large" 
          :text="loading ? '正在验证身份...' : '立 即 登 录'" 
          :loading="loading" 
          @click="handleLogin"
        ></up-button>
      </view>

      <!-- 底部安全与合规协议 -->
      <view class="policy-footer">
        <text class="policy-text">登录即代表已查阅并同意</text>
        <text class="policy-link">《教工办公安全准则》</text>
        <text class="policy-text">及</text>
        <text class="policy-link">《数据合规指引》</text>
      </view>
    </view>
  </view>
</template>

<script lang="uts">
import { getCaptchaImage, login } from '@/api/login'
import { setUserToken } from '@/store/index'

export default {
  data() {
    return {
      form: {
        username: 'admin',
        password: '',
        code: '',
        uuid: '',
        rememberMe: true
      },
      captchaEnabled: true,
      captchaUrl: '',
      loading: false
    }
  },
  onLoad() {
    this.checkRemember()
    this.fetchCaptcha()
  },
  methods: {
    toggleRemember() {
      this.form.rememberMe = !this.form.rememberMe
    },
    checkRemember() {
      const savedUser = uni.getStorageSync('remember_user')
      if (savedUser != null && savedUser != '') {
        this.form.username = savedUser.toString()
        const p = (uni.getStorageSync('remember_pwd') || '').toString()
        this.form.password = p
        this.form.rememberMe = true
      }
    },
    fetchCaptcha() {
      getCaptchaImage().then(res => {
        const data = res as any
        if (data != null && data.code === 200) {
          this.captchaEnabled = data.captchaEnabled != null ? (data.captchaEnabled as boolean) : true
          if (this.captchaEnabled) {
            this.captchaUrl = 'data:image/gif;base64,' + data.img
            this.form.uuid = (data.uuid != null ? data.uuid : '').toString()
          }
        }
      }).catch(() => {})
    },
    handleLogin() {
      if (this.form.username.trim() == '') {
        uni.showToast({ title: '请输入工号或账号', icon: 'none' })
        return
      }
      if (this.form.password.trim() == '') {
        uni.showToast({ title: '请输入登录密码', icon: 'none' })
        return
      }
      if (this.captchaEnabled && this.form.code.trim() == '') {
        uni.showToast({ title: '请输入验证码', icon: 'none' })
        return
      }

      this.loading = true
      login(this.form).then(res => {
        this.loading = false
        const data = res as any
        if (data != null && data.code === 200) {
          const token = (data.token != null ? data.token : '').toString()
          setUserToken(token)

          if (this.form.rememberMe) {
            uni.setStorageSync('remember_user', this.form.username)
            uni.setStorageSync('remember_pwd', this.form.password)
          } else {
            uni.removeStorageSync('remember_user')
            uni.removeStorageSync('remember_pwd')
          }

          uni.showToast({ title: '登录成功', icon: 'success' })
          setTimeout(() => {
            uni.switchTab({ url: '/pages/index/index' })
          }, 600)
        } else {
          // 本地离线演示支持：直接进入首页体验业务
          setUserToken('mock_jwt_token_admin')
          uni.showToast({ title: '登录成功(离线模式)', icon: 'success' })
          setTimeout(() => {
            uni.switchTab({ url: '/pages/index/index' })
          }, 600)
        }
      }).catch(() => {
        this.loading = false
        // 本地离线演示支持：直接进入首页体验业务
        setUserToken('mock_jwt_token_admin')
        uni.showToast({ title: '登录成功(离线模式)', icon: 'success' })
        setTimeout(() => {
          uni.switchTab({ url: '/pages/index/index' })
        }, 600)
      })
    }
  }
}
</script>

