<template>
  <scroll-view class="info-page" scroll-y="true">
    <view class="container">
      <view class="form-card">
        <text class="card-caption">基本信息设置</text>

        <view class="form-item">
          <text class="item-label">用户昵称</text>
          <up-input
            v-model="form.nickName"
            placeholder="请输入昵称"
            prefixIcon="/static/icons/settings-user.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="form-item">
          <text class="item-label">手机号码</text>
          <up-input
            v-model="form.phonenumber"
            placeholder="请输入手机号码"
            prefixIcon="/static/icons/about-phone.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="form-item">
          <text class="item-label">电子邮箱</text>
          <up-input
            v-model="form.email"
            placeholder="请输入电子邮箱"
            prefixIcon="/static/icons/about-mail.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="btn-wrap">
          <up-button 
            type="primary" 
            size="large" 
            shape="circle"
            text="保 存 修 改" 
            @click="handleSave"
          ></up-button>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { userStore } from '@/store/index'

export default {
  data() {
    return {
      form: {
        nickName: userStore.name,
        phonenumber: '13800000000',
        email: 'admin@doupi.com'
      }
    }
  },
  methods: {
    handleSave() {
      if (this.form.nickName.trim() == '') {
        uni.showToast({ title: '昵称不能为空', icon: 'none' })
        return
      }
      userStore.name = this.form.nickName
      uni.showToast({ title: '资料保存成功', icon: 'success' })
      setTimeout(() => {
        uni.navigateBack()
      }, 800)
    }
  }
}
</script>

