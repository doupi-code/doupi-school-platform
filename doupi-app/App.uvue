<script lang="uts">
import { getToken } from '@/utils/auth'

export default {
  onLaunch: function () {
    console.log('App Launch')
    const token = getToken()
    if (token == null || token == '') {
      uni.reLaunch({
        url: '/pages/login/login'
      })
    }
  },
  onShow: function () {
    console.log('App Show')
  },
  onHide: function () {
    console.log('App Hide')
  }
}
</script>

