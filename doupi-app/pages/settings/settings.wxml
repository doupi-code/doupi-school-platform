<view class="settings-page">
  <view class="settings-content">
    <view class="settings-main">
      <view class="settings-section">
        <view class="settings-section__header">
          <text class="settings-section__title">账号设置</text>
        </view>
        <view class="settings-cell" bindtap="goToEdit">
          <view class="settings-cell__left">
            <view class="settings-cell__icon settings-cell__icon--user">
              <image class="settings-icon-image" src="/images/icons/settings-user.svg" mode="aspectFit" />
            </view>
            <text class="settings-cell__text">个人资料</text>
          </view>
          <view class="settings-cell__right">
            <text class="settings-cell__note" wx:if="{{userInfo.nickname}}">{{userInfo.nickname}}</text>
            <image class="settings-arrow" src="/images/icons/settings-chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
      </view>

      <view class="settings-section">
        <view class="settings-section__header">
          <text class="settings-section__title">隐私与安全</text>
        </view>
        <view class="settings-cell" bindtap="goToPrivacy">
          <view class="settings-cell__left">
            <view class="settings-cell__icon settings-cell__icon--lock">
              <image class="settings-icon-image" src="/images/icons/settings-lock.svg" mode="aspectFit" />
            </view>
            <text class="settings-cell__text">隐私政策</text>
          </view>
          <image class="settings-arrow" src="/images/icons/settings-chevron-right.svg" mode="aspectFit" />
        </view>
        <view class="settings-divider"></view>
        <view class="settings-cell" bindtap="goToAgreement">
          <view class="settings-cell__left">
            <view class="settings-cell__icon settings-cell__icon--file">
              <image class="settings-icon-image" src="/images/icons/settings-file.svg" mode="aspectFit" />
            </view>
            <text class="settings-cell__text">用户协议</text>
          </view>
          <image class="settings-arrow" src="/images/icons/settings-chevron-right.svg" mode="aspectFit" />
        </view>
      </view>

      <view class="settings-section">
        <view class="settings-cell" bindtap="goToAbout">
          <view class="settings-cell__left">
            <view class="settings-cell__icon settings-cell__icon--info">
              <image class="settings-icon-image" src="/images/icons/settings-info.svg" mode="aspectFit" />
            </view>
            <text class="settings-cell__text">关于我们</text>
          </view>
          <view class="settings-cell__right">
            <text class="settings-cell__version">{{version}}</text>
            <image class="settings-arrow" src="/images/icons/settings-chevron-right.svg" mode="aspectFit" />
          </view>
        </view>
      </view>
    </view>

    <view class="settings-logout-wrap">
      <button class="btn-logout" bindtap="handleLogout">
        <image class="logout-icon" src="/images/icons/settings-logout.svg" mode="aspectFit" />
        <text>退出登录</text>
      </button>
    </view>
  </view>

  <profile-edit-modal
    visible="{{showProfileEditModal}}"
    force="{{false}}"
    bind:close="onProfileEditModalClose"
    bind:saved="onProfileEditModalSaved"
  />
</view>
