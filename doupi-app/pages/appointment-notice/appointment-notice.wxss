.page {
  min-height: 100vh;
  background: #F5F6F8;
}

.update-info {
  padding: 12rpx 32rpx 4rpx;
}

.update-time {
  font-size: 22rpx;
  color: #888;
}

.content {
  height: calc(100vh - 88rpx - env(safe-area-inset-bottom));
  padding: 20rpx 28rpx;
}

.content-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 36rpx 32rpx;
}

.rich-text {
  font-size: 28rpx;
  color: #444;
  line-height: 2;
}

.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.btn-agree {
  width: 100%;
  height: 92rpx;
  background: linear-gradient(135deg, #3088F4 0%, #1E6FE6 100%);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 20rpx;
  border: none;
}

.bottom-spacer {
  height: 120rpx;
}
