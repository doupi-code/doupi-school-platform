.page {
  min-height: 100vh;
  background: #F5F6F8;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.upload-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  line-height: 1.6;
}

.form-group {
  margin-bottom: 28rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '*';
  color: #FF4D4F;
  margin-right: 8rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
  line-height: 1.6;
}

.summary-textarea {
  min-height: 160rpx;
}

.char-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
}

.cover-wrap {
  margin-top: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #F8F9FA;
}

.cover-image {
  width: 100%;
  height: 360rpx;
  display: block;
}

.cover-actions {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx 24rpx;
}

.cover-action {
  flex: 1;
  height: 76rpx;
  border-radius: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
}

.cover-action.primary {
  background: #E8F2FE;
  color: #3088F4;
}

.cover-action.danger {
  background: #FFF1F0;
  color: #FF4D4F;
}

.cover-empty {
  margin-top: 20rpx;
  min-height: 280rpx;
  background: #F8F9FA;
  border: 2rpx dashed #D9D9D9;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
}

.cover-empty-icon {
  font-size: 64rpx;
  color: #999;
  line-height: 1;
}

.cover-empty-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.cover-empty-desc {
  font-size: 22rpx;
  color: #999;
}

.banner-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.banner-item {
  overflow: hidden;
  border-radius: 20rpx;
  background: #F8F9FA;
}

.banner-image {
  width: 100%;
  height: 260rpx;
  display: block;
}

.banner-actions {
  display: flex;
  gap: 16rpx;
  padding: 16rpx 20rpx 20rpx;
}

.banner-action {
  flex: 1;
  height: 68rpx;
  border-radius: 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  background: #F5F6F8;
  color: #666;
}

.banner-action.primary {
  background: #E8F2FE;
  color: #3088F4;
}

.banner-action.danger {
  background: #FFF1F0;
  color: #FF4D4F;
}

.banner-empty {
  margin-top: 20rpx;
  min-height: 120rpx;
  background: #F8F9FA;
  border: 2rpx dashed #D9D9D9;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.banner-add-btn {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 38rpx;
  background: #E8F2FE;
  color: #3088F4;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.editor-toolbar {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
  margin-bottom: 16rpx;
}

.toolbar-btn {
  min-width: 96rpx;
  height: 60rpx;
  padding: 0 20rpx;
  background: #F5F6F8;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #666;
}

.toolbar-btn.action {
  background: #E8F2FE;
  color: #3088F4;
}

.editor-wrap {
  width: 100%;
  min-height: 720rpx;
  border: 2rpx solid #E6E8EB;
  border-radius: 16rpx;
  background: #fff;
  overflow: hidden;
}

.editor {
  width: 100%;
  min-height: 720rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

.btn-row {
  display: flex;
  gap: 24rpx;
}

.reset-btn {
  width: 200rpx;
  height: 96rpx;
  background: #F5F6F8;
  color: #666;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 96rpx;
  flex-shrink: 0;
}

.save-btn {
  flex: 1;
  height: 96rpx;
  background: #3088F4;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 48rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 96rpx;
}

.save-btn.disabled {
  background: #B3CDE8;
  color: rgba(255, 255, 255, 0.8);
}

.bottom-spacer {
  height: calc(160rpx + env(safe-area-inset-bottom));
}

.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.06);
  z-index: 90;
}
