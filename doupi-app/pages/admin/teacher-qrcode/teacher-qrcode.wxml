<view class="page">
  <scroll-view scroll-y class="content" enhanced show-scrollbar="{{false}}">
    <view class="card teacher-card">
      <view class="teacher-header">
        <view class="teacher-avatar">
          <t-icon name="usergroup" size="40rpx" color="#3088F4"></t-icon>
        </view>
        <view>
          <text class="teacher-name">{{teacherInfo.name}}</text>
          <text class="teacher-role">{{teacherInfo.roleText}}</text>
        </view>
      </view>
      <view class="teacher-row">
        <text class="teacher-label">老师编号</text>
        <text class="teacher-value">{{teacherInfo.code}}</text>
      </view>
      <view class="teacher-row">
        <text class="teacher-label">手机号</text>
        <text class="teacher-value">{{teacherInfo.phone}}</text>
      </view>
      <view class="teacher-row" wx:if="{{teacherInfo.roleText === '招生老师'}}">
        <text class="teacher-label">绑定时间</text>
        <text class="teacher-date">{{isBound ? (teacherInfo.bindDate || displayText.noRecord) : displayText.unbound}}</text>
      </view>
      <view class="teacher-row" wx:if="{{teacherInfo.roleText === '招生老师'}}">
        <text class="teacher-label">所属主任</text>
        <text class="teacher-value">{{isBound ? (teacherInfo.directorName || '主任信息待补全') : displayText.unbound}}</text>
      </view>
    </view>

    <view class="card bind-tip" wx:if="{{teacherInfo.roleText === '招生老师' && !isBound && !bindingLoading}}">
      <view class="bind-tip__title">{{displayText.unbound}}招生主任</view>
      <text class="bind-tip__desc" wx:if="{{bindRequest.status === 'pending'}}">已提交绑定申请，等待主任「{{bindRequest.directorName || '未指定'}}」审核。审核通过后可正常展示所属主任。</text>
      <text class="bind-tip__desc" wx:elif="{{bindRequest.status === 'rejected'}}">绑定申请已驳回（{{bindRequest.rejectReason || '未填写原因'}}），请重新选择主任发起绑定。</text>
      <text class="bind-tip__desc" wx:else>请先选择并绑定招生主任，提交申请后即可生成并使用个人二维码。</text>
      <view class="bind-tip__actions">
        <button class="bind-tip__btn" bindtap="goBindDirector">去绑定招生主任</button>
      </view>
    </view>

    <view class="card qrcode-card">
      <text class="section-title center">我的招生二维码</text>
      <view class="qrcode-box" wx:if="{{qrCodeData.qrImageUrl || qrImageLoading}}">
        <view class="qrcode-stage">
          <view class="qrcode-skeleton" wx:if="{{qrImageLoading}}"></view>
          <image
            wx:if="{{qrCodeData.qrImageUrl}}"
            class="qrcode-image"
            src="{{qrCodeData.qrImageUrl}}"
            mode="aspectFit"
            show-menu-by-longpress="{{true}}"
            bindtap="previewQrCode"
            bindload="onQrImageLoad"
            binderror="onQrImageError"
          />
        </view>
        <text class="qrcode-tip">扫码预约参观</text>
        <text class="qrcode-validity" wx:if="{{qrValidityText}}">{{qrValidityText}}</text>
      </view>
      <view class="qrcode-box qrcode-empty" wx:elif="{{canUseQrFeature}}" bindtap="generateQrCode">
        <text class="qrcode-empty-text">{{generating ? displayText.generatingQr : displayText.clickGenerateQr}}</text>
      </view>
      <view class="qrcode-box qrcode-empty" wx:elif="{{bindingLoading}}">
        <text class="qrcode-empty-text">正在检查绑定状态...</text>
      </view>
      <view class="qrcode-box qrcode-empty" wx:else>
        <text class="qrcode-empty-text">{{qrUnavailableText}}</text>
      </view>

      <view class="tips-panel">
        <text class="tips-title">使用说明</text>
        <text class="tips-line">• 家长扫码后将自动关联您的名下</text>
        <text class="tips-line">• 您可以在"我的预约"中查看所有预约</text>
        <text class="tips-line">• 下载后可分享到微信、朋友圈等平台</text>
        <text class="tips-line">• 二维码长期有效，请妥善保管</text>
      </view>

      <view class="btn-row">
      <button class="btn btn-primary" bindtap="downloadQrCode" disabled="{{!canUseQrFeature}}">
        <t-icon name="download" size="26rpx" color="#FFFFFF"></t-icon>
        {{displayText.btnDownloadQr}}
      </button>
        <button class="btn btn-green" open-type="share" disabled="{{!canUseQrFeature}}">
          <t-icon name="share" size="26rpx" color="#FFFFFF"></t-icon>
          {{displayText.btnShareQr}}
        </button>
      </view>
      <button class="btn btn-light" bindtap="resetQrCode" disabled="{{!canUseQrFeature}}">
        <t-icon name="refresh" size="26rpx" color="#3088F4"></t-icon>
        {{resetting ? displayText.resetting : displayText.btnRegenerateQr}}
      </button>
    </view>

    <view class="card">
      <view class="title-row">
        <view class="title-row__icon-wrap">
          <t-icon t-class="title-row__icon" name="chart" size="36rpx" color="#3088F4"></t-icon>
        </view>
        <text class="section-title section-title--metrics">我的招生数据</text>
      </view>
      <view class="stats-grid" wx:if="{{!statsLoading}}">
        <view class="stat-box stat-blue">
          <text class="stat-value blue">{{stats.totalScanCount}}</text>
          <text class="stat-label">累计扫码次数</text>
        </view>
        <view class="stat-box stat-green">
          <text class="stat-value green">{{stats.appointmentByQrCount}}</text>
          <text class="stat-label">扫码预约人数</text>
        </view>
        <view class="stat-box stat-orange">
          <text class="stat-value orange">{{stats.verifiedCount}}</text>
          <text class="stat-label">已核销数量</text>
        </view>
      </view>
      <view class="stats-grid" wx:else>
        <view class="stat-box stat-loading">
          <view class="stat-skeleton stat-skeleton-value"></view>
          <view class="stat-skeleton stat-skeleton-label"></view>
        </view>
        <view class="stat-box stat-loading">
          <view class="stat-skeleton stat-skeleton-value"></view>
          <view class="stat-skeleton stat-skeleton-label"></view>
        </view>
        <view class="stat-box stat-loading">
          <view class="stat-skeleton stat-skeleton-value"></view>
          <view class="stat-skeleton stat-skeleton-label"></view>
        </view>
      </view>
    </view>

    <view class="card warm-panel">
      <view class="warm-title">
        <t-icon name="error-circle-filled" size="26rpx" color="#FAAD14"></t-icon>
        温馨提示
      </view>
      <text class="warm-line">• 定期查看招生数据，了解招生效果</text>
      <text class="warm-line">• 建议将二维码保存到相册，方便随时分享</text>
      <text class="warm-line">• 如二维码泄露，可立即重新生成</text>
      <text class="warm-line">• 有问题请联系管理员处理</text>
    </view>
  </scroll-view>
</view>
