.page { min-height: 100vh; background: #F5F6F8; display: flex; flex-direction: column; }
.search-bar { display: flex; gap: 16rpx; padding: 24rpx; background: #fff; }
.search-input { flex: 1; height: 72rpx; background: #F5F6F8; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; }
.search-btn { width: 128rpx; height: 72rpx; line-height: 72rpx; border: none; border-radius: 12rpx; background: #3088F4; color: #fff; font-size: 26rpx; }
.search-btn::after { border: none; }
.batch-bar { background: #fff; padding: 0 24rpx 16rpx; }
.batch-reason-input { height: 68rpx; line-height: 68rpx; background: #F5F6F8; border-radius: 12rpx; padding: 0 16rpx; font-size: 24rpx; color: #333; margin-top: 10rpx; }
.batch-actions { display: flex; gap: 12rpx; margin-top: 10rpx; }
.batch-btn { flex: 1; height: 72rpx; line-height: 72rpx; border: none; border-radius: 12rpx; background: #52C41A; color: #fff; font-size: 26rpx; }
.batch-btn::after { border: none; }
.batch-reject { background: #FFF1F0; color: #FF4D4F; }
.list-wrap { flex: 1; padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.audit-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; }
.row { display: flex; justify-content: space-between; align-items: center; margin-top: 10rpx; }
.row.top { margin-top: 0; margin-bottom: 8rpx; }
.left { display: flex; align-items: center; gap: 12rpx; }
.check { width: 32rpx; height: 32rpx; border-radius: 999rpx; border: 2rpx solid #C9CDD4; }
.check.checked { border-color: #3088F4; background: #3088F4; }
.name { font-size: 28rpx; color: #333; font-weight: 600; }
.time { font-size: 22rpx; color: #999; }
.label { font-size: 24rpx; color: #666; }
.value { font-size: 24rpx; color: #333; }
.reason-wrap { margin-top: 12rpx; }
.reason-input { margin-top: 8rpx; height: 66rpx; line-height: 66rpx; background: #F5F6F8; border-radius: 10rpx; padding: 0 16rpx; font-size: 24rpx; color: #333; }
.actions { margin-top: 18rpx; display: flex; gap: 12rpx; }
.btn { flex: 1; height: 72rpx; line-height: 72rpx; border: none; border-radius: 12rpx; font-size: 26rpx; }
.btn::after { border: none; }
.pass { background: #3088F4; color: #fff; }
.reject { background: #FFF1F0; color: #FF4D4F; }
.empty { text-align: center; color: #999; font-size: 24rpx; margin-top: 80rpx; }
