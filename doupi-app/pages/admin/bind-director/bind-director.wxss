.page { min-height: 100vh; background: #F5F6F8; display: flex; flex-direction: column; }
.status-card { margin: 24rpx 24rpx 0; padding: 20rpx 24rpx; border-radius: 16rpx; background: #E8F2FE; color: #1D4ED8; display: flex; flex-direction: column; gap: 8rpx; }
.status-card__title { font-size: 28rpx; font-weight: 600; }
.status-card__desc { font-size: 24rpx; color: #476282; }
.search-bar { display: flex; gap: 16rpx; padding: 24rpx; background: #fff; }
.search-input { flex: 1; height: 72rpx; background: #F5F6F8; border-radius: 12rpx; padding: 0 20rpx; font-size: 26rpx; }
.search-btn { width: 128rpx; height: 72rpx; line-height: 72rpx; border: none; border-radius: 12rpx; background: #3088F4; color: #fff; font-size: 26rpx; }
.search-btn::after { border: none; }
.list-wrap { flex: 1; padding: 20rpx 24rpx; box-sizing: border-box; }
.director-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; border: 2rpx solid #fff; display: flex; justify-content: space-between; align-items: center; }
.director-item.active { border-color: #3088F4; }
.left { display: flex; align-items: center; gap: 16rpx; }
.avatar-wrap { width: 56rpx; height: 56rpx; border-radius: 999rpx; background: #E8F2FE; display: flex; align-items: center; justify-content: center; }
.info { display: flex; flex-direction: column; }
.name { font-size: 28rpx; color: #333; font-weight: 600; }
.phone { margin-top: 6rpx; font-size: 24rpx; color: #999; }
.check { width: 36rpx; height: 36rpx; border-radius: 999rpx; border: 2rpx solid #C9CDD4; }
.check.checked { border-color: #3088F4; background: #3088F4; }
.empty { text-align: center; color: #999; font-size: 24rpx; margin-top: 80rpx; }
.footer { padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom)); background: #fff; box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, 0.04); }
.submit-btn { height: 84rpx; line-height: 84rpx; border: none; border-radius: 14rpx; background: #3088F4; color: #fff; font-size: 30rpx; font-weight: 600; }
.submit-btn::after { border: none; }
.hint { display: block; text-align: center; color: #999; font-size: 22rpx; margin-top: 10rpx; }
