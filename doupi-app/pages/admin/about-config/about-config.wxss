.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #F5F6F8;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 20rpx 24rpx 24rpx;
  box-sizing: border-box;
}

.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-header {
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.card-desc,
.sync-subtitle {
  display: block;
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #999999;
  line-height: 1.6;
}

.sync-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FCFF 100%);
  border: 2rpx solid #E8F2FE;
}

.sync-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.sync-action {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F2FE;
}

.sync-action-text {
  font-size: 24rpx;
  color: #3088F4;
  font-weight: 600;
}

.sync-tip {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #F5FAFF;
}

.sync-tip-text {
  flex: 1;
  min-width: 0;
  font-size: 23rpx;
  color: #4E5969;
  line-height: 1.7;
}

.readonly-panel {
  margin-top: 20rpx;
  padding: 22rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #EEF2F6;
}

.readonly-label {
  display: block;
  font-size: 22rpx;
  color: #999999;
}

.readonly-title {
  display: block;
  margin-top: 10rpx;
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
}

.intro-label {
  margin-top: 22rpx;
}

.readonly-content {
  display: block;
  margin-top: 10rpx;
  font-size: 25rpx;
  color: #555555;
  line-height: 1.8;
  white-space: pre-wrap;
}

.form-group {
  margin-bottom: 20rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 84rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  border-radius: 12rpx;
  background: #F8F9FA;
  font-size: 26rpx;
  color: #333333;
}

.bottom-spacer {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

.bottom-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  padding: 10rpx 16rpx calc(10rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 90;
}

.btn-row {
  display: flex;
  gap: 14rpx;
}

.reset-btn {
  flex: 0 0 176rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: 2rpx solid #D9D9D9;
  border-radius: 36rpx;
  background: #FFFFFF;
  color: #666666;
  font-size: 26rpx;
}

.save-btn {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
  border-radius: 36rpx;
  background: #3088F4;
  color: #FFFFFF;
  font-size: 28rpx;
}

.save-btn.disabled {
  background: #B3CDE8;
}
