/**
 * 管理后台仪表盘样式
 */

.page {
  min-height: 100vh;
  background-color: #F5F6F8;
  display: flex;
  flex-direction: column;
}

.content {
  flex: 1;
  min-height: 0;
  padding: 20rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.portal-switch-banner {
  background: linear-gradient(135deg, #1677FF 0%, #3088F4 100%);
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(22, 119, 255, 0.2);
}

.portal-switch-banner__left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.portal-switch-banner__badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.portal-switch-banner__text {
  font-size: 24rpx;
  opacity: 0.95;
}

.portal-switch-banner__btn {
  font-size: 24rpx;
  font-weight: 500;
  opacity: 0.9;
}

.scope-tip {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #E8F2FE;
}

.scope-tip__text {
  font-size: 22rpx;
  color: #1E4F92;
  line-height: 1.6;
  display: block;
}

/* ==================== 功能列表区域 ==================== */

.function-list,
.recent-section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 快捷功能列表 */
.list-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  transition: all 0.2s ease;
}

.list-item:active {
  background-color: #FAFAFA;
}

.list-left {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  flex: 1;
}

.list-icon {
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52rpx;
  height: 52rpx;
  border-radius: 13rpx;
}

.icon-appointments { background-color: #EBF4FF; }
.icon-users { background-color: #F6FFED; }
.icon-campus { background-color: #FFFBE6; }
.icon-stats { background-color: #F9F0FF; }
.icon-recruitment { background-color: #E6F7FF; }
.icon-binding { background-color: #E6FFFB; }
.icon-config { background-color: #FFF7E6; }
.icon-logs { background-color: #F5F5F5; }

.list-main {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.list-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.list-desc {
  font-size: 22rpx;
  color: #999999;
  line-height: 1.4;
}

.divider {
  height: 2rpx;
  background-color: #F5F6F8;
  margin-left: 68rpx;
}

/* 模块卡片 */
.module-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.module-card {
  background-color: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.module-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 16rpx;
  gap: 12rpx;
}

.module-title {
  display: block;
  font-size: 30rpx;
  color: #333;
  font-weight: 600;
}

.module-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #999;
}

.module-stats {
  display: flex;
  gap: 10rpx;
}

.stat-chip {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  padding: 8rpx 10rpx;
  border-radius: 14rpx;
  background-color: #F7F9FC;
  box-sizing: border-box;
}

.stat-chip.alert {
  background-color: #FFF1F0;
}

.stat-value {
  font-size: 24rpx;
  color: #3088F4;
  font-weight: 600;
}

.stat-value.alert {
  color: #FF4D4F;
}

.stat-label {
  margin-top: 2rpx;
  font-size: 18rpx;
  color: #999;
  white-space: nowrap;
  line-height: 1.2;
}

.stat-label.alert {
  color: #FF7875;
}

.module-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.module-item {
  background-color: #FAFBFC;
  border-radius: 14rpx;
  padding: 16rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.module-item:active {
  background-color: #F2F5F8;
}

.module-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.module-item-title {
  font-size: 22rpx;
  color: #333;
}

/* ==================== 最近预约区域 ==================== */

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 0 16rpx;
}

.view-all {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  background-color: #EBF4FF;
  border-radius: 16rpx;
  transition: all 0.2s ease;
}

.view-all:active {
  background-color: #D6E9FF;
}

.view-all text {
  font-size: 24rpx;
  color: #3088F4;
  font-weight: 500;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.recent-item {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.recent-item:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}

.recent-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.recent-info {
  flex: 1;
  min-width: 0;
}

.recent-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.recent-name {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.status-badge {
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.status-pending { background-color: #FFF7E6; color: #FAAD14; }
.status-approved { background-color: #F6FFED; color: #52C41A; }
.status-rejected { background-color: #FFF1F0; color: #FF4D4F; }
.status-completed { background-color: #EBF4FF; color: #3088F4; }

.recent-number {
  font-size: 24rpx;
  color: #888888;
  display: block;
  margin-bottom: 8rpx;
  font-family: 'SF Mono', 'Menlo', monospace;
}

.recent-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-campus {
  font-size: 24rpx;
  color: #666666;
}

.meta-divider {
  font-size: 22rpx;
  color: #CCCCCC;
}

.meta-date {
  font-size: 24rpx;
  color: #666666;
}

.bottom-spacer {
  height: 48rpx;
}
