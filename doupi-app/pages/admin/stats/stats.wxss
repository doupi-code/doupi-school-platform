/* ========== 页面基础 ========== */
.page {
  min-height: 100vh;
  background: #F5F6F8;
  display: flex;
  flex-direction: column;
}

/* ========== 页面头部 ========== */
/* ========== 内容滚动区 ========== */
.content {
  flex: 1;
  min-height: 0;
  padding: 24rpx 24rpx 0;
  box-sizing: border-box;
}

/* ========== 时间维度切换 ========== */
.time-tabs {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.scope-tip {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  margin: 0 8rpx 20rpx;
  border: 2rpx solid #E8F2FE;
}

.scope-tip__text {
  font-size: 22rpx;
  color: #1E4F92;
  line-height: 1.6;
  display: block;
}

.time-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #666;
  background: #fff;
  border-radius: 12rpx;
  transition: all 0.2s ease;
}

.time-tab.active {
  color: #fff;
  background: #3088F4;
  font-weight: 500;
}

/* ========== 核心数据卡片 ========== */
.overview-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.overview-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 12rpx 22rpx;
  position: relative;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.overview-card__icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.card-value {
  font-size: 34rpx;
  color: #111111;
  font-weight: 700;
  display: block;
  line-height: 1.2;
  margin-bottom: 10rpx;
  word-break: break-all;
}

.card-label {
  font-size: 24rpx;
  color: #111111;
  font-weight: 600;
  display: block;
  line-height: 1.4;
  word-break: break-all;
}

.card-trend {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-top: 8rpx;
}

.trend-up {
  background: #F6FFED;
  color: #52C41A;
}

.trend-down {
  background: #FFF1F0;
  color: #FF4D4F;
}

.trend-icon {
  font-size: 20rpx;
}

.trend-text {
  font-size: 18rpx;
}

/* ========== 通用区块卡片 ========== */
.section-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.section-sub {
  font-size: 24rpx;
  color: #999;
}

.section-link {
  font-size: 24rpx;
  color: #3088F4;
  font-weight: 500;
  line-height: 1.4;
}

/* ========== 招生老师概况 ========== */
.teacher-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
}

.teacher-item {
  text-align: center;
  padding: 20rpx 8rpx;
  background: #FAFBFC;
  border-radius: 16rpx;
}

.teacher-value {
  font-size: 36rpx;
  color: #3088F4;
  font-weight: 600;
  display: block;
  margin-bottom: 6rpx;
}

.teacher-label {
  font-size: 22rpx;
  color: #666;
  display: block;
}

/* ========== 来源分布 ========== */
.source-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.source-item {
  position: relative;
}

.source-item--clickable:active {
  opacity: 0.8;
}

.source-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.source-color {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex-shrink: 0;
}

.source-label {
  font-size: 26rpx;
  color: #333;
}

.source-right {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  float: right;
}

.source-count {
  font-size: 30rpx;
  color: #333;
  font-weight: 500;
}

.source-percent {
  font-size: 24rpx;
  color: #999;
}

.source-bar-track {
  clear: both;
  height: 12rpx;
  background: #F0F0F0;
  border-radius: 6rpx;
  overflow: hidden;
  margin-top: 10rpx;
}

.source-bar-fill {
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.4s ease;
}

/* ========== 双栏布局 ========== */
.dual-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.half-card {
  margin-bottom: 0;
}

/* ========== 状态分布 ========== */
.status-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.status-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status-item--clickable:active {
  opacity: 0.8;
}

.status-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-label {
  font-size: 26rpx;
  color: #333;
}

.status-count {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

/* ========== 排行榜 ========== */
.rank-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.rank-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rank-item--clickable:active {
  opacity: 0.8;
}

.rank-num {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  background: #F5F5F5;
  color: #999;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.rank-top {
  background: linear-gradient(135deg, #FFB340, #FF8C00);
  color: #fff;
}

.rank-name {
  font-size: 26rpx;
  color: #333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.rank-main {
  flex: 1;
  min-width: 0;
}

.rank-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 6rpx;
}

.rank-meta__item,
.rank-meta__dot {
  font-size: 20rpx;
  color: #999999;
  flex-shrink: 0;
}

.rank-count {
  font-size: 24rpx;
  color: #3088F4;
  font-weight: 500;
  flex-shrink: 0;
}
