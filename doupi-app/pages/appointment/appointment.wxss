.appointment-page {
  height: 100vh;
  background: #f3f4f6;
  overflow: hidden;
}

.appointment-page t-loading {
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 60vh;
}

.appointment-scroll {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 20rpx 0;
}

.form-section {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 36rpx;
  line-height: 54rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 14rpx;
}

.field-wrap {
  margin-bottom: 16rpx;
}

.field-wrap:last-child {
  margin-bottom: 0;
}

/* 输入框：补全四边边框并增加轻阴影 */
.field-wrap .t-input {
  border: 2rpx solid #eceef2;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 38, 74, 0.04);
}

.field-wrap .t-input--border::after {
  display: none;
}

.field-label {
  font-size: 28rpx;
  color: #333;
  line-height: 40rpx;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.required {
  color: #e34d59;
  margin-left: 4rpx;
}

.date-box {
  height: 72rpx;
  border: 2rpx solid #eceef2;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 38, 74, 0.04);
}

.date-box-placeholder {
  color: #b7b7b7;
}

.picker-trigger {
  position: relative;
  height: 88rpx;
  border: 2rpx solid #eceef2;
  border-radius: 16rpx;
  padding: 0 64rpx 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 38, 74, 0.04);
}

.picker-trigger::after {
  content: '';
  position: absolute;
  right: 24rpx;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #b8c1cc;
  border-right: 2rpx solid #b8c1cc;
  transform: translateY(-50%) rotate(45deg);
}

.picker-placeholder {
  color: #b7b7b7;
}

.remark-box {
  width: 100%;
  min-height: 120rpx;
  border: 2rpx solid #eceef2;
  border-radius: 16rpx;
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(20, 38, 74, 0.04);
  padding: 18rpx 24rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
}

.agreement-section {
  background: #fff;
  border-radius: 24rpx;
  /* 给文字更多横向空间 */
  padding: 16rpx 22rpx;
  margin-bottom: 24rpx;
}

.agreement-row {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 4rpx 0;
  flex-wrap: nowrap;
}

.agreement-checkbox-icon {
  margin-right: 4rpx !important;
  width: 36rpx !important;
  flex-shrink: 0;
}

.agreement-text {
  /* 贴近勾选框并占满剩余宽度 */
  margin-left: 0;
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 38rpx;
  color: #666;
  /* 强制单行：避免 checkbox 勾选后文案换到下一行 */
  white-space: nowrap;
  word-break: normal;
  overflow: hidden;
  text-overflow: ellipsis;
}

.link {
  color: #3088f4;
  font-weight: 500;
  margin: 0 1rpx;
}

.link-read {
  color: #1e6fd8;
}

.error-text {
  color: #e34d59;
  font-size: 24rpx;
  line-height: 34rpx;
  margin-top: 8rpx;
}

.submit-btn {
  display: block;
  margin-bottom: 32rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  background: #3088f4;
  color: #fff;
  font-size: 32rpx;
  line-height: 96rpx;
  font-weight: 500;
  border: none;
}

.submit-bottom-spacer {
  height: calc(env(safe-area-inset-bottom) + 80rpx);
}

.success-card {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.success-title {
  font-size: 32rpx;
  color: #333;
  font-weight: 600;
}

.success-info {
  margin-top: 10rpx;
  color: #3088f4;
  font-size: 28rpx;
}
