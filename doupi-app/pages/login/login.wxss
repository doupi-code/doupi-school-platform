page {
  height: 100vh;
  overflow: hidden;
  padding-bottom: 0 !important;
}

.page {
  height: 100vh;
  background: #f0f2f5;
  padding: 0 19rpx;
  box-sizing: border-box;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.hero {
  height: 46vh;
  background: #3088f4;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  padding-top: 132rpx;
  box-sizing: border-box;
  flex-shrink: 0;
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  overflow: hidden;
}

.hero-bg {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-mask {
  position: absolute;
  inset: 0;
  background: rgba(48, 136, 244, 0.72);
}

.hero-icon-wrap {
  position: relative;
  z-index: 1;
  width: 192rpx;
  height: 192rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.hero-icon {
  width: 168rpx;
  height: 168rpx;
}

.hero-icon-box {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid #fff;
  border-radius: 14rpx;
  position: relative;
}

.hero-icon-check {
  position: absolute;
  left: 30rpx;
  top: 18rpx;
  width: 18rpx;
  height: 34rpx;
  border: 6rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.hero-title {
  position: relative;
  z-index: 1;
  font-size: 56rpx;
  line-height: 72rpx;
  color: #fff;
  font-weight: 500;
  text-align: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.hero-subtitle {
  position: relative;
  z-index: 1;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: rgba(255, 255, 255, 0.85);
  text-align: center;
  padding: 0 40rpx;
  box-sizing: border-box;
}

.card {
  width: 100%;
  background: #fff;
  border-top-left-radius: 48rpx;
  border-top-right-radius: 48rpx;
  margin-top: -48rpx;
  padding: 64rpx 48rpx 24rpx;
  box-sizing: border-box;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  position: relative;
  z-index: 2;
}

.title {
  display: block;
  font-size: 40rpx;
  line-height: 60rpx;
  color: #333;
  font-weight: 500;
}

.desc {
  display: block;
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #666;
}

.input-wrap {
  margin-top: 36rpx;
  height: 96rpx;
  border: 2rpx solid #ededed;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
  background: #fff;
}

.prefix {
  display: flex;
  align-items: center;
  height: 96rpx;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 400;
  color: #333333;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.phone-input {
  flex: 1;
  height: 96rpx;
  font-size: 36rpx;
  line-height: 52rpx;
  font-weight: 400;
  color: #333333;
  padding: 0;
  margin: 0;
  vertical-align: middle;
}

.agreement-line {
  margin-top: 38rpx;
  display: flex;
  align-items: center;
  flex-wrap: nowrap;
}

.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 8rpx;
  margin-right: 12rpx;
  box-sizing: border-box;
  flex-shrink: 0;
}

.checkbox--checked {
  border-color: #3088f4;
  background: #3088f4;
  position: relative;
}

.checkbox--checked::after {
  content: '';
  position: absolute;
  left: 9rpx;
  top: 4rpx;
  width: 8rpx;
  height: 14rpx;
  border: 3rpx solid #fff;
  border-top: 0;
  border-left: 0;
  transform: rotate(45deg);
}

.agreement-text {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #666;
  margin-right: 8rpx;
  white-space: nowrap;
}

.link {
  font-size: 28rpx;
  line-height: 40rpx;
  color: #3088f4;
  white-space: nowrap;
  margin-right: 8rpx;
}

.error-text {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #ff4d4f;
}

.primary-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 96rpx;
  border-radius: 16rpx;
  border: none;
  background: #3088f4;
  color: #fff;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 96rpx;
}

.primary-btn::after {
  border: none;
}

.primary-btn[disabled] {
  opacity: 0.6;
}

.button-hover {
  opacity: 0.92;
}

.code-actions {
  margin-top: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.other-login {
  margin-top: 44rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.line {
  flex: 1;
  height: 2rpx;
  background: #eee;
}

.other-text {
  font-size: 24rpx;
  color: #999;
  white-space: nowrap;
}

.quick-login-btn-wrap {
  margin-top: 20rpx;
  width: 100%;
}

.quick-login-btn[disabled] {
  opacity: 0.55;
}

.decline-login-btn {
  margin-top: 20rpx;
  width: 100%;
  height: 76rpx;
  border: none;
  border-radius: 16rpx;
  background: transparent;
  color: #666666;
  font-size: 28rpx;
  line-height: 76rpx;
}

.decline-login-btn::after {
  border: none;
}

.decline-login-btn[disabled] {
  opacity: 0.5;
}

.auth-modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  z-index: 1200;
  box-sizing: border-box;
}

.auth-modal {
  width: 100%;
  max-width: 620rpx;
  background: #ffffff;
  border-radius: 28rpx;
  padding: 40rpx 32rpx 32rpx;
  box-sizing: border-box;
}

.auth-modal__title {
  display: block;
  font-size: 34rpx;
  line-height: 48rpx;
  color: #1f2329;
  font-weight: 600;
  text-align: center;
}

.auth-modal__desc {
  display: block;
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  color: #666666;
  text-align: center;
}

.auth-modal__actions {
  margin-top: 36rpx;
  display: flex;
  gap: 20rpx;
}

.auth-modal__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  border: none;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
}

.auth-modal__btn::after {
  border: none;
}

.auth-modal__btn--ghost {
  background: #f5f6f8;
  color: #333333;
}

.auth-modal__btn--primary {
  background: #3088f4;
  color: #ffffff;
}
