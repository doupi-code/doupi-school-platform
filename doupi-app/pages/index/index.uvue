<script lang="uts">
import { userStore, setUserInfo } from '@/store/index'
import { getInfo } from '@/api/login'
import { getRecruitDashboardStats } from '@/api/recruit'

type StatsData = {
  todayTotal: number
  pendingTotal: number
  verifiedTotal: number
  rate: string
}

export default {
  data() {
    return {
      userStore,
      stats: {
        todayTotal: 48,
        pendingTotal: 12,
        verifiedTotal: 36,
        rate: '75%'
      } as StatsData
    }
  },
  onShow() {
    this.loadUserInfo()
    this.loadStats()
  },
  methods: {
    loadUserInfo() {
      getInfo().then(res => {
        const data = res as any
        if (data != null && data.code === 200 && data.user != null) {
          const u = data.user
          const name = (u.nickName || u.userName || '').toString()
          const avatar = (u.avatar || '').toString()
          const roles = (data.roles != null ? data.roles : []) as string[]
          const perms = (data.permissions != null ? data.permissions : []) as string[]
          setUserInfo(name, avatar, roles, perms)
        }
      }).catch(() => {})
    },
    loadStats() {
      getRecruitDashboardStats().then(res => {
        const data = res as any
        if (data != null && data.data != null) {
          const d = data.data
          if (d.todayTotal != null) this.stats.todayTotal = d.todayTotal as number
          if (d.pendingTotal != null) this.stats.pendingTotal = d.pendingTotal as number
          if (d.verifiedTotal != null) this.stats.verifiedTotal = d.verifiedTotal as number
          if (d.rate != null) this.stats.rate = d.rate.toString()
        }
      }).catch(() => {})
    },
    navTo(url: string) {
      uni.navigateTo({ url })
    }
  }
}
</script>

