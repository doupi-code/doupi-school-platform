<template>
  <scroll-view class="print-page" scroll-y="true">
    <!-- 顶部状态切换 (使用 up-tabs 组件) -->
    <view class="seg-header">
      <up-tabs 
        :list="tabs" 
        lineColor="#165DFF"
        activeStyle="color: #165DFF; font-weight: bold;"
        @click="handleTabClick"
      ></up-tabs>
    </view>

    <!-- 列表展示 (使用 up-tag, up-button 组件) -->
    <view class="list-container">
      <view 
        class="print-card" 
        v-for="(item, index) in filteredList" 
        :key="index"
      >
        <view class="card-head">
          <text class="card-title">{{ item.title }}</text>
          <text class="card-extra">单号: {{ item.recordNo }}</text>
        </view>

        <view class="item-meta-row">
          <up-tag 
            :type="getStatusTagType(item.status)" 
            :text="formatStatus(item.status)" 
            size="mini"
          ></up-tag>
          <up-tag 
            v-if="item.secretLevel === 'CONFIDENTIAL'" 
            type="error" 
            text="机密试卷" 
            size="mini" 
            plain
          ></up-tag>
          <text class="item-time">{{ item.createTime }}</text>
        </view>

        <view class="meta-grid">
          <view class="meta-cell">
            <text class="meta-label">申请人：</text>
            <text class="meta-val">{{ item.applicant }} ({{ item.deptName }})</text>
          </view>
          <view class="meta-cell">
            <text class="meta-label">印制规格：</text>
            <text class="meta-val text-bold">{{ item.paperSize }} / {{ item.printType }}</text>
          </view>
          <view class="meta-cell">
            <text class="meta-label">印制份数：</text>
            <text class="meta-val text-blue">{{ item.printCount }} 份 (共 {{ item.totalPages }} 页)</text>
          </view>
        </view>

        <view class="card-footer">
          <view class="footer-btns">
            <up-button 
              v-if="item.status === 'PENDING'" 
              type="primary" 
              size="mini" 
              shape="circle"
              text="批准文印"
              @click="handleApprove(item)"
            ></up-button>
            <up-button 
              v-if="item.status === 'PROCESSING'" 
              type="success" 
              size="mini" 
              shape="circle"
              text="确认完成"
              @click="handleComplete(item)"
            ></up-button>
            <up-button 
              v-if="item.status === 'COMPLETED'" 
              type="info" 
              size="mini" 
              shape="circle"
              text="打印凭单"
              @click="handleViewDetail(item)"
            ></up-button>
          </view>
        </view>
      </view>

      <!-- 空状态 (使用 up-empty 组件) -->
      <up-empty 
        v-if="filteredList.length === 0" 
        mode="order" 
        text="暂无相关文印工单"
      ></up-empty>
    </view>

    <!-- 底部悬浮新建按钮 (使用 up-button 组件) -->
    <view class="bottom-bar">
      <up-button 
        type="primary" 
        size="large" 
        shape="circle"
        text="+ 提 交 新 文 印 申 请"
        @click="handleCreate"
      ></up-button>
    </view>
  </scroll-view>
</template>

<script lang="uts">
type PrintItem = {
  recordId: number
  recordNo: string
  title: string
  applicant: string
  deptName: string
  paperSize: string
  printType: string
  printCount: number
  totalPages: number
  secretLevel: string
  status: string
  createTime: string
}

export default {
  data() {
    return {
      currentStatus: '',
      tabs: [
        { name: '全部', status: '' },
        { name: '待印制', status: 'PENDING' },
        { name: '印制中', status: 'PROCESSING' },
        { name: '已完成', status: 'COMPLETED' }
      ] as any[],
      list: [
        {
          recordId: 1,
          recordNo: 'PR2026100501',
          title: '高一年级 10 月月考数学试卷与答题卡',
          applicant: '张立华',
          deptName: '高中数学教研组',
          paperSize: '8K 双面',
          printType: '试卷胶印',
          printCount: 450,
          totalPages: 1800,
          secretLevel: 'CONFIDENTIAL',
          status: 'PENDING',
          createTime: '今天 09:30'
        },
        {
          recordId: 2,
          recordNo: 'PR2026100502',
          title: '初三年级中考一轮复习物理导学案',
          applicant: '李建军',
          deptName: '初中物理组',
          paperSize: 'A4 双面装订',
          printType: '速印',
          printCount: 320,
          totalPages: 1280,
          secretLevel: 'NORMAL',
          status: 'PROCESSING',
          createTime: '昨天 15:40'
        },
        {
          recordId: 3,
          recordNo: 'PR2026100401',
          title: '全校教职工代表大会会议纪要与手册',
          applicant: '王敏 (校办主任)',
          deptName: '校长办公室',
          paperSize: 'A4 彩印胶装',
          printType: '精装手册',
          printCount: 120,
          totalPages: 480,
          secretLevel: 'NORMAL',
          status: 'COMPLETED',
          createTime: '10-04 11:20'
        }
      ] as PrintItem[]
    }
  },
  computed: {
    filteredList(): PrintItem[] {
      if (this.currentStatus === '') {
        return this.list
      }
      return this.list.filter((item: PrintItem): boolean => item.status === this.currentStatus)
    }
  },
  methods: {
    handleTabClick(item: any) {
      if (item != null && item.status != null) {
        this.currentStatus = item.status.toString()
      } else if (item != null && item.index != null) {
        const idx = item.index as number
        this.currentStatus = this.tabs[idx].status.toString()
      }
    },
    formatStatus(status: string): string {
      if (status === 'PENDING') return '待印制'
      if (status === 'PROCESSING') return '印制中'
      if (status === 'COMPLETED') return '已完成'
      return '已归档'
    },
    getStatusTagType(status: string): string {
      if (status === 'PENDING') return 'warning'
      if (status === 'PROCESSING') return 'primary'
      if (status === 'COMPLETED') return 'success'
      return 'info'
    },
    handleApprove(item: PrintItem) {
      item.status = 'PROCESSING'
      uni.showToast({ title: '已批准进入印制流程', icon: 'success' })
    },
    handleComplete(item: PrintItem) {
      item.status = 'COMPLETED'
      uni.showToast({ title: '已标记文印完成', icon: 'success' })
    },
    handleViewDetail(item: PrintItem) {
      uni.showToast({ title: '凭单已准备好打印', icon: 'none' })
    },
    handleCreate() {
      uni.showToast({ title: '请填写新文印工单', icon: 'none' })
    }
  }
}
</script>

<style>
.print-page {
  flex: 1;
  background-color: #F6F7F9;
  flex-direction: column;
}

.seg-header {
  background-color: #FFFFFF;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #F2F3F5;
}

.list-container {
  padding: 16px;
  flex-direction: column;
  padding-bottom: 90px;
}

.print-card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 16px;
  margin-bottom: 12px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  flex-direction: column;
}

.card-head {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 10px;
  border-bottom-width: 1px;
  border-bottom-style: solid;
  border-bottom-color: #F2F3F5;
  margin-bottom: 10px;
}

.card-title {
  font-size: 16px;
  font-weight: bold;
  color: #1D2129;
}

.card-extra {
  font-size: 13px;
  color: #86909C;
}

.item-meta-row {
  flex-direction: row;
  align-items: center;
  gap: 8px;
  margin-bottom: 10px;
}

.item-time {
  font-size: 12px;
  color: #86909C;
  margin-left: auto;
}

.meta-grid {
  flex-direction: column;
  background-color: #F7F8FA;
  border-radius: 8px;
  padding: 10px 12px;
  gap: 4px;
}

.meta-cell {
  flex-direction: row;
  align-items: center;
}

.meta-label {
  font-size: 13px;
  color: #86909C;
}

.meta-val {
  font-size: 13px;
  color: #1D2129;
}

.text-bold {
  font-weight: 500;
}

.text-blue {
  color: #165DFF;
  font-weight: bold;
}

.card-footer {
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #F2F3F5;
  padding-top: 12px;
  margin-top: 12px;
  flex-direction: row;
  justify-content: flex-end;
}

.footer-btns {
  flex-direction: row;
  justify-content: flex-end;
  gap: 8px;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: #FFFFFF;
  padding: 12px 16px;
  border-top-width: 1px;
  border-top-style: solid;
  border-top-color: #F2F3F5;
}
</style>
