<template>
  <scroll-view class="pwd-page" scroll-y="true">
    <view class="container">
      <view class="form-card">
        <text class="card-caption">修改安全登录密码</text>

        <view class="form-item">
          <text class="item-label">当前密码</text>
          <up-input
            v-model="form.oldPassword"
            type="password"
            placeholder="请输入当前密码"
            prefixIcon="/static/icons/settings-lock.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="form-item">
          <text class="item-label">新密码</text>
          <up-input
            v-model="form.newPassword"
            type="password"
            placeholder="请输入新密码 (不少于6位)"
            prefixIcon="/static/icons/settings-lock.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="form-item">
          <text class="item-label">确认新密码</text>
          <up-input
            v-model="form.confirmPassword"
            type="password"
            placeholder="请再次输入新密码"
            prefixIcon="/static/icons/settings-lock.svg"
            prefixIconStyle="width: 20px; height: 20px; margin-right: 8px;"
            border="surround"
            shape="circle"
          ></up-input>
        </view>

        <view class="btn-wrap">
          <up-button 
            type="primary" 
            size="large" 
            shape="circle"
            text="确 认 修 改 密 码" 
            @click="handleUpdatePwd"
          ></up-button>
        </view>
      </view>
    </view>
  </scroll-view>
</template>

<script lang="uts">
export default {
  data() {
    return {
      form: {
        oldPassword: '',
        newPassword: '',
        confirmPassword: ''
      }
    }
  },
  methods: {
    handleUpdatePwd() {
      if (this.form.oldPassword == '') {
        uni.showToast({ title: '请输入旧密码', icon: 'none' })
        return
      }
      if (this.form.newPassword.length < 6) {
        uni.showToast({ title: '新密码不能少于6位', icon: 'none' })
        return
      }
      if (this.form.newPassword != this.form.confirmPassword) {
        uni.showToast({ title: '两次新密码输入不一致', icon: 'none' })
        return
      }

      uni.showToast({ title: '密码修改成功', icon: 'success' })
      setTimeout(() => {
        uni.navigateBack()
      }, 800)
    }
  }
}
</script>

<style>
.pwd-page {
  flex: 1;
  background-color: #F6F7F9;
  flex-direction: column;
}

.container {
  padding: 16px;
  flex-direction: column;
}

.form-card {
  background-color: #FFFFFF;
  border-radius: 16px;
  padding: 20px;
  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  flex-direction: column;
}

.card-caption {
  font-size: 16px;
  font-weight: bold;
  color: #1D2129;
  margin-bottom: 20px;
}

.form-item {
  flex-direction: column;
  margin-bottom: 18px;
}

.item-label {
  font-size: 13px;
  color: #86909C;
  margin-bottom: 8px;
}

.btn-wrap {
  margin-top: 12px;
}
</style>
