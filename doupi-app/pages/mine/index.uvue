<template>
  <scroll-view class="profile-page" scroll-y="true">
    <!-- 顶部个人名片 -->
    <view class="profile-hero">
      <view class="hero-card">
        <image class="avatar-hero" :src="userStore.avatar || '/static/icons/default-avatar.png'" mode="aspectFill"></image>
        <view class="meta-column">
          <view class="name-tag-row">
            <text class="user-realname">{{ userStore.name || '龙涛' }}</text>
            <text class="role-badge">正式教工</text>
          </view>
          <text class="job-title">{{ userStore.deptName || '管理部' }} · {{ userStore.roleName || '管理员' }}</text>
          <text class="campus-title">所属校区：汉外华襄校区</text>
        </view>
      </view>

      <!-- 个人业务统计指标 -->
      <view class="metric-row">
        <view class="metric-box">
          <text class="metric-value">48</text>
          <text class="metric-label">我的核销</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-box">
          <text class="metric-value text-orange">3</text>
          <text class="metric-label">待办审批</text>
        </view>
        <view class="metric-divider"></view>
        <view class="metric-box">
          <text class="metric-value text-green">100%</text>
          <text class="metric-label">出勤率</text>
        </view>
      </view>
    </view>

    <!-- 账号与安全分组 (专业矢量图标) -->
    <view class="inset-group">
      <text class="group-caption">账号与安全</text>
      <view class="group-card">
        <view class="cell-line" @click="navTo('/pages/mine/info')">
          <image class="cell-vector-icon" src="/static/icons/settings-user.svg" mode="aspectFit"></image>
          <text class="cell-txt">修改个人资料</text>
          <image class="chevron-right" src="/static/icons/settings-chevron-right.svg" mode="aspectFit"></image>
        </view>

        <view class="cell-line" @click="navTo('/pages/mine/password')">
          <image class="cell-vector-icon" src="/static/icons/settings-lock.svg" mode="aspectFit"></image>
          <text class="cell-txt">修改登录密码</text>
          <image class="chevron-right" src="/static/icons/settings-chevron-right.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 系统偏好设置 (专业矢量图标) -->
    <view class="inset-group">
      <text class="group-caption">系统与维护</text>
      <view class="group-card">
        <view class="cell-line" @click="handleClearCache">
          <image class="cell-vector-icon" src="/static/icons/mine-settings.svg" mode="aspectFit"></image>
          <text class="cell-txt">清理运行缓存</text>
          <text class="cell-sub">2.4 MB</text>
          <image class="chevron-right" src="/static/icons/settings-chevron-right.svg" mode="aspectFit"></image>
        </view>

        <view class="cell-line" @click="handleAbout">
          <image class="cell-vector-icon" src="/static/icons/settings-info.svg" mode="aspectFit"></image>
          <text class="cell-txt">关于工作台</text>
          <text class="cell-sub">uni-app x 原生版</text>
          <image class="chevron-right" src="/static/icons/settings-chevron-right.svg" mode="aspectFit"></image>
        </view>
      </view>
    </view>

    <!-- 退出登录按钮 (使用 up-button 官方组件) -->
    <view class="action-footer">
      <up-button 
        type="error" 
        plain 
        shape="circle" 
        size="large"
        icon="/static/icons/settings-logout.svg"
        text="退出当前账号"
        @click="handleLogout"
      ></up-button>
    </view>
  </scroll-view>
</template>

<script lang="uts">
import { userStore, clearUserSession } from '@/store/index'
import { logout } from '@/api/login'

export default {
  data() {
    return {
      userStore
    }
  },
  methods: {
    navTo(url: string) {
      uni.navigateTo({ url })
    },
    handleClearCache() {
      uni.showModal({
        title: '清理缓存',
        content: '确定要释放本地运行缓存吗？',
        success: (res) => {
          if (res.confirm) {
            uni.showToast({ title: '已释放 2.4 MB 缓存', icon: 'success' })
          }
        }
      })
    },
    handleAbout() {
      uni.showModal({
        title: '关于工作台',
        content: '豆皮智慧校园移动管理工作台\n版本：v1.0.0 (uni-app x)\n原生渲染引擎，支持鸿蒙 HarmonyOS NEXT、iOS、Android',
        showCancel: false
      })
    },
    handleLogout() {
      uni.showModal({
        title: '确认退出',
        content: '确定要注销并返回登录页面吗？',
        success: (res) => {
          if (res.confirm) {
            logout().catch(() => {})
            clearUserSession()
            uni.reLaunch({ url: '/pages/login/login' })
          }
        }
      })
    }
  }
}
</script>

