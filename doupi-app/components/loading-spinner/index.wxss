/**
 * loading-spinner 组件样式
 */

.loading-spinner {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-base);
}

/* 全屏模式 */
.loading-spinner--fullscreen {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: var(--z-modal);
  background-color: rgba(255, 255, 255, 0.9);
}

.loading-spinner--transparent {
  background-color: transparent;
}

/* 内容容器 */
.loading-spinner__container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* ==================== 旋转加载器 ==================== */

.loading-spinner__spinner {
  border-radius: 50%;
  border: 4rpx solid rgba(48, 136, 244, 0.15);
  animation: spin 0.8s linear infinite;
}

/* 尺寸变体 */
.loading-spinner__spinner--small {
  width: 48rpx;
  height: 48rpx;
  border-width: 3rpx;
}

.loading-spinner__spinner--medium {
  width: 64rpx;
  height: 64rpx;
  border-width: 4rpx;
}

.loading-spinner__spinner--large {
  width: 96rpx;
  height: 96rpx;
  border-width: 6rpx;
}

@keyframes spin {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

/* ==================== 点状加载器 ==================== */

.loading-spinner__dots {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.loading-spinner__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  opacity: 0.3;
  animation: dotPulse 1.4s ease-in-out infinite;
}

@keyframes dotPulse {
  0%, 80%, 100% {
    transform: scale(0.6);
    opacity: 0.3;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

/* ==================== 文本样式 ==================== */

.loading-spinner__text {
  margin-top: var(--spacing-sm);
  font-size: var(--font-size-sm);
  color: var(--text-tertiary);
  text-align: center;
}

/* ==================== 骨架屏 ==================== */

.loading-spinner__skeleton {
  width: 100%;
  padding: var(--spacing-base);
}

.loading-spinner__skeleton-line {
  height: 32rpx;
  background: linear-gradient(
    90deg,
    #f0f0f0 25%,
    #e0e0e0 37%,
    #f0f0f0 63%
  );
  background-size: 400% 100%;
  animation: skeletonShimmer 1.4s ease infinite;
  border-radius: var(--radius-xs);
  margin-bottom: var(--spacing-md);
}

.loading-spinner__skeleton-line--title {
  width: 40%;
  height: 40rpx;
}

.loading-spinner__skeleton-line--short {
  width: 60%;
}

.loading-spinner__skeleton-line--medium {
  width: 80%;
}

@keyframes skeletonShimmer {
  0% {
    background-position: 100% 50%;
  }
  100% {
    background-position: 0% 50%;
  }
}
