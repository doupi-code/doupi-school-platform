/* 自定义 TabBar：高度 56px、图标 22px、主色 #3088F4、未选 #999 */
.hx-tabbar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 9999;
  display: flex;
  align-items: flex-start;
  justify-content: space-around;
  height: calc(112rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #ffffff;
  border-top: 1rpx solid #eeeeee;
  box-sizing: border-box;
  overflow: hidden;
}

.hx-tabbar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 112rpx;
  padding-top: 8rpx;
}

.hx-tabbar-icon {
  width: 44rpx;
  height: 44rpx;
}

.hx-tabbar-icon--active {
  opacity: 1;
}

.hx-tabbar-icon--inactive {
  opacity: 0.75;
}

.hx-tabbar-text {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #999999;
}

.hx-tabbar-text--active {
  color: #3088f4;
}
